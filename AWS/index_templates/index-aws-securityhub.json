{
  "index_patterns": [
    "aws-securityhub-*"
  ],
  "priority": 200,
  "composed_of": [
    "sofelk-toolkit-aws-common"
  ],
  "template": {
    "mappings": {
      "_meta": {
        "toolkit_schema": "aws-securityhub",
        "toolkit_schema_version": 1
      },
      "properties": {
        "message": {
          "type": "match_only_text"
        },
        "event": {
          "properties": {
            "severity": {
              "type": "long"
            },
            "created": {
              "type": "date"
            }
          }
        },
        "source": {
          "properties": {
            "ip": {
              "type": "ip"
            },
            "port": {
              "type": "integer"
            },
            "domain": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "destination": {
          "properties": {
            "ip": {
              "type": "ip"
            },
            "port": {
              "type": "integer"
            },
            "domain": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "network": {
          "properties": {
            "direction": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "transport": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "process": {
          "properties": {
            "name": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "executable": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "pid": {
              "type": "long"
            },
            "parent": {
              "properties": {
                "pid": {
                  "type": "long"
                }
              }
            }
          }
        },
        "vulnerability": {
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "aws": {
          "properties": {
            "securityhub": {
              "properties": {
                "id": {
                  "type": "keyword",
                  "ignore_above": 8191
                },
                "product_arn": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "product_name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "company_name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "generator_id": {
                  "type": "keyword",
                  "ignore_above": 8191
                },
                "schema_version": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "record_state": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "verification_state": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "workflow_state": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "workflow_status": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "source_url": {
                  "type": "keyword",
                  "ignore_above": 8191
                },
                "aws_account_name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "types": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "malware_names": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "threat_intel_values": {
                  "type": "keyword",
                  "ignore_above": 8191
                },
                "severity": {
                  "properties": {
                    "label": {
                      "type": "keyword",
                      "ignore_above": 1024
                    },
                    "original": {
                      "type": "keyword",
                      "ignore_above": 1024
                    },
                    "normalized": {
                      "type": "integer"
                    }
                  }
                },
                "compliance": {
                  "properties": {
                    "status": {
                      "type": "keyword",
                      "ignore_above": 1024
                    },
                    "security_control_id": {
                      "type": "keyword",
                      "ignore_above": 1024
                    }
                  }
                },
                "resource": {
                  "properties": {
                    "id": {
                      "type": "keyword",
                      "ignore_above": 8191
                    },
                    "type": {
                      "type": "keyword",
                      "ignore_above": 1024
                    },
                    "region": {
                      "type": "keyword",
                      "ignore_above": 1024
                    },
                    "partition": {
                      "type": "keyword",
                      "ignore_above": 1024
                    }
                  }
                },
                "remediation": {
                  "properties": {
                    "url": {
                      "type": "keyword",
                      "ignore_above": 8191
                    },
                    "text": {
                      "type": "keyword",
                      "ignore_above": 8191,
                      "fields": {
                        "text": {
                          "type": "match_only_text"
                        }
                      }
                    }
                  }
                },
                "title": {
                  "type": "keyword",
                  "ignore_above": 8191,
                  "fields": {
                    "text": {
                      "type": "match_only_text"
                    }
                  }
                },
                "description": {
                  "type": "keyword",
                  "ignore_above": 8191,
                  "fields": {
                    "text": {
                      "type": "match_only_text"
                    }
                  }
                },
                "updated_at": {
                  "type": "date"
                },
                "created_at": {
                  "type": "date"
                },
                "first_observed_at": {
                  "type": "date"
                },
                "last_observed_at": {
                  "type": "date"
                },
                "processed_at": {
                  "type": "date"
                },
                "confidence": {
                  "type": "integer"
                },
                "criticality": {
                  "type": "integer"
                },
                "flattened": {
                  "properties": {
                    "resources": {
                      "type": "keyword",
                      "ignore_above": 8191,
                      "fields": {
                        "text": {
                          "type": "match_only_text"
                        }
                      }
                    },
                    "product_fields": {
                      "type": "keyword",
                      "ignore_above": 8191,
                      "fields": {
                        "text": {
                          "type": "match_only_text"
                        }
                      }
                    },
                    "user_defined_fields": {
                      "type": "keyword",
                      "ignore_above": 8191,
                      "fields": {
                        "text": {
                          "type": "match_only_text"
                        }
                      }
                    },
                    "network": {
                      "type": "keyword",
                      "ignore_above": 8191,
                      "fields": {
                        "text": {
                          "type": "match_only_text"
                        }
                      }
                    },
                    "process": {
                      "type": "keyword",
                      "ignore_above": 8191,
                      "fields": {
                        "text": {
                          "type": "match_only_text"
                        }
                      }
                    },
                    "malware": {
                      "type": "keyword",
                      "ignore_above": 8191,
                      "fields": {
                        "text": {
                          "type": "match_only_text"
                        }
                      }
                    },
                    "threat_intel_indicators": {
                      "type": "keyword",
                      "ignore_above": 8191,
                      "fields": {
                        "text": {
                          "type": "match_only_text"
                        }
                      }
                    },
                    "action": {
                      "type": "keyword",
                      "ignore_above": 8191,
                      "fields": {
                        "text": {
                          "type": "match_only_text"
                        }
                      }
                    },
                    "vulnerabilities": {
                      "type": "keyword",
                      "ignore_above": 8191,
                      "fields": {
                        "text": {
                          "type": "match_only_text"
                        }
                      }
                    },
                    "finding_provider_fields": {
                      "type": "keyword",
                      "ignore_above": 8191,
                      "fields": {
                        "text": {
                          "type": "match_only_text"
                        }
                      }
                    }
                  }
                },
                "unmapped": {
                  "type": "object",
                  "dynamic": "true"
                },
                "malformed": {
                  "type": "keyword",
                  "ignore_above": 8191
                }
              }
            }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "AWS Security Hub findings, ASFF (AWS/securityhub2sofelk.py)",
    "provider": "SOF-ELK-Import-Toolkit",
    "version": 1
  }
}
