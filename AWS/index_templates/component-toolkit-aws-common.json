{
  "template": {
    "settings": {
      "index": {
        "number_of_shards": "1",
        "number_of_replicas": 0,
        "auto_expand_replicas": "0-1",
        "codec": "best_compression",
        "mapping": {
          "total_fields": {
            "limit": 2000
          },
          "ignore_malformed": true
        }
      }
    },
    "mappings": {
      "dynamic": "false",
      "date_detection": false,
      "numeric_detection": false,
      "dynamic_templates": [
        {
          "unknown_strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 8191
            }
          }
        }
      ],
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "case": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "labels": {
          "properties": {
            "evidence_source": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "event": {
          "properties": {
            "dataset": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "kind": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "category": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "outcome": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "action": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "log": {
          "properties": {
            "file": {
              "properties": {
                "path": {
                  "type": "keyword",
                  "ignore_above": 4096
                }
              }
            },
            "offset": {
              "type": "long"
            }
          }
        },
        "cloud": {
          "properties": {
            "provider": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "region": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "availability_zone": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "account": {
              "properties": {
                "id": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "Fields shared by every SOF-ELK Import Toolkit AWS index: evidence source, case, provenance (log.file.path, log.offset) and ECS cloud.*",
    "provider": "SOF-ELK-Import-Toolkit",
    "version": 1
  }
}
