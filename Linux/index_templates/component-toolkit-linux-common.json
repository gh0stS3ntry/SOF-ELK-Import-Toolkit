{
  "template": {
    "settings": {
      "index": {
        "number_of_shards": "1",
        "number_of_replicas": 0,
        "auto_expand_replicas": "0-1",
        "codec": "best_compression",
        "mapping": {
          "total_fields": {
            "limit": 2000
          },
          "ignore_malformed": true
        }
      }
    },
    "mappings": {
      "dynamic": "false",
      "date_detection": false,
      "numeric_detection": false,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "case": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "tags": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "labels": {
          "properties": {
            "type": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "event": {
          "properties": {
            "dataset": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "kind": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "category": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "type": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "action": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "outcome": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "timezone": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "log": {
          "properties": {
            "file": {
              "properties": {
                "path": {
                  "type": "keyword",
                  "ignore_above": 8191
                }
              }
            },
            "offset": {
              "type": "long"
            }
          }
        },
        "host": {
          "properties": {
            "name": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "id": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "os": {
              "properties": {
                "type": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "version": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "full": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "platform": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "family": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "kernel": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "Fields shared by every SOF-ELK Import Toolkit Linux index: evidence host (host.name) and its profile (host.id, host.os.*), case, event.*, provenance (log.file.path, log.offset)",
    "provider": "SOF-ELK-Import-Toolkit",
    "version": 1
  }
}
