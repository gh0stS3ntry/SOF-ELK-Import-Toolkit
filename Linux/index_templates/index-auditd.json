{
  "index_patterns": [
    "auditd-*"
  ],
  "priority": 200,
  "composed_of": [
    "sofelk-toolkit-linux-common"
  ],
  "template": {
    "mappings": {
      "_meta": {
        "toolkit_schema": "auditd",
        "toolkit_schema_version": 1
      },
      "properties": {
        "message": {
          "type": "keyword",
          "ignore_above": 8191,
          "fields": {
            "text": {
              "type": "match_only_text"
            }
          }
        },
        "auditd": {
          "properties": {
            "sequence": {
              "type": "long"
            },
            "node": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "session": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "result": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "key": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "log": {
              "properties": {
                "record_type": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "record_types": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "paths": {
              "properties": {
                "name": {
                  "type": "keyword",
                  "ignore_above": 8191
                },
                "nametype": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "inode": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "mode": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "ouid": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "ogid": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "item": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "data": {
              "properties": {
                "syscall": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "arch": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "exit": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "tty": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "op": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "terminal": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "res": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "unit": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "a0": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "a1": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "a2": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "a3": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "items": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "ppid_comm": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "hostname": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "addr": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "name": {
                  "type": "keyword",
                  "ignore_above": 8191
                },
                "socket": {
                  "properties": {
                    "family": {
                      "type": "keyword",
                      "ignore_above": 1024
                    },
                    "addr": {
                      "type": "ip"
                    },
                    "port": {
                      "type": "long"
                    },
                    "path": {
                      "type": "keyword",
                      "ignore_above": 8191
                    }
                  }
                }
              }
            }
          }
        },
        "process": {
          "properties": {
            "pid": {
              "type": "long"
            },
            "parent": {
              "properties": {
                "pid": {
                  "type": "long"
                }
              }
            },
            "name": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "executable": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "command_line": {
              "type": "keyword",
              "ignore_above": 8191,
              "fields": {
                "text": {
                  "type": "match_only_text"
                }
              }
            },
            "args": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "title": {
              "type": "keyword",
              "ignore_above": 8191,
              "fields": {
                "text": {
                  "type": "match_only_text"
                }
              }
            },
            "working_directory": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "user": {
              "properties": {
                "id": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "name": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            }
          }
        },
        "user": {
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "name": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "audit": {
              "properties": {
                "id": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "name": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "effective": {
              "properties": {
                "id": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "name": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "group": {
                  "properties": {
                    "id": {
                      "type": "keyword",
                      "ignore_above": 1024
                    },
                    "name": {
                      "type": "keyword",
                      "ignore_above": 1024
                    }
                  }
                }
              }
            },
            "group": {
              "properties": {
                "id": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "name": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "target": {
              "properties": {
                "id": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "name": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            }
          }
        },
        "group": {
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "name": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "file": {
          "properties": {
            "path": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "inode": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "mode": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "uid": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "gid": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "owner": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "group": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "source": {
          "properties": {
            "ip": {
              "type": "ip"
            },
            "address": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "port": {
              "type": "long"
            }
          }
        },
        "destination": {
          "properties": {
            "ip": {
              "type": "ip"
            },
            "port": {
              "type": "long"
            }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "Linux audit log (auditd2sofelk.py): one document per audit event, Auditbeat-style auditd.* plus ECS process/user/file/source/destination",
    "provider": "SOF-ELK-Import-Toolkit",
    "version": 1
  }
}
