  "_meta": {
    "description": "Linux accounts and persistence snapshot (Linux/linuxconfig2sofelk.py): one document per account, group, sudoers rule, cron entry, systemd unit, script line, SSH key, hosts entry, resolver/loader setting, repository; ECS user/group/file/process/url + toolkit linuxconfig.*",
    "provider": "SOF-ELK-Import-Toolkit",
    "version": 1
  }
}
