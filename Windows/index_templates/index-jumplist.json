{
  "index_patterns": [
    "jumplist-*"
  ],
  "priority": 200,
  "composed_of": [
    "sofelk-toolkit-common"
  ],
  "template": {
    "mappings": {
      "_meta": {
        "toolkit_schema": "jumplist",
        "toolkit_schema_version": 1
      },
      "properties": {
        "file": {
          "properties": {
            "accessed": {
              "type": "date"
            }
          }
        },
        "jumplist": {
          "properties": {
            "app_id": {
              "type": "keyword"
            },
            "app_id_description": {
              "type": "keyword"
            },
            "arguments": {
              "fields": {
                "text": {
                  "type": "match_only_text"
                }
              },
              "ignore_above": 8191,
              "type": "keyword"
            },
            "common_path": {
              "ignore_above": 8191,
              "type": "keyword"
            },
            "dest_list_version": {
              "type": "long"
            },
            "drive_type": {
              "type": "keyword"
            },
            "entry_created": {
              "type": "date"
            },
            "entry_last_modified": {
              "type": "date"
            },
            "entry_name": {
              "type": "keyword"
            },
            "entry_number": {
              "type": "keyword"
            },
            "extra_blocks_present": {
              "type": "keyword"
            },
            "file_attributes": {
              "type": "keyword"
            },
            "header_flags": {
              "type": "keyword"
            },
            "hostname": {
              "type": "keyword"
            },
            "interaction_count": {
              "type": "long"
            },
            "last_used_entry_number": {
              "type": "keyword"
            },
            "local_path": {
              "fields": {
                "text": {
                  "type": "match_only_text"
                }
              },
              "ignore_above": 8191,
              "type": "keyword"
            },
            "mac_address": {
              "type": "keyword"
            },
            "malformed": {
              "ignore_above": 8191,
              "type": "keyword"
            },
            "mru": {
              "type": "long"
            },
            "notes": {
              "type": "keyword"
            },
            "path": {
              "fields": {
                "text": {
                  "type": "match_only_text"
                }
              },
              "ignore_above": 8191,
              "type": "keyword"
            },
            "pinned": {
              "type": "boolean"
            },
            "relative_path": {
              "ignore_above": 8191,
              "type": "keyword"
            },
            "source": {
              "properties": {
                "accessed": {
                  "type": "date"
                },
                "created": {
                  "type": "date"
                },
                "modified": {
                  "type": "date"
                },
                "path": {
                  "ignore_above": 8191,
                  "type": "keyword"
                }
              }
            },
            "target_id_absolute_path": {
              "ignore_above": 8191,
              "type": "keyword"
            },
            "target_mft_entry_number": {
              "type": "keyword"
            },
            "target_mft_sequence_number": {
              "type": "keyword"
            },
            "tracker": {
              "properties": {
                "created": {
                  "type": "date"
                },
                "file_birth_droid": {
                  "type": "keyword"
                },
                "file_droid": {
                  "type": "keyword"
                },
                "machine_id": {
                  "type": "keyword"
                },
                "machine_mac_address": {
                  "type": "keyword"
                },
                "volume_birth_droid": {
                  "type": "keyword"
                },
                "volume_droid": {
                  "type": "keyword"
                }
              }
            },
            "unmapped": {
              "dynamic": "true",
              "type": "object"
            },
            "volume_label": {
              "type": "keyword"
            },
            "volume_serial_number": {
              "type": "keyword"
            },
            "working_directory": {
              "ignore_above": 8191,
              "type": "keyword"
            }
          }
        },
        "user": {
          "properties": {
            "name": {
              "type": "keyword"
            }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "Explicit schema for JLECmd CSV output loaded by jlecmd2sofelk.py: ECS file.path/name/extension/size/created/mtime/accessed for the LNK target, user.name, jumplist.* for the rest",
    "provider": "SOF-ELK-Import-Toolkit",
    "version": 1
  }
}
