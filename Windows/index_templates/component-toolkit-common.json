{
  "template": {
    "settings": {
      "index": {
        "number_of_shards": "1",
        "number_of_replicas": 0,
        "auto_expand_replicas": "0-1",
        "codec": "best_compression",
        "mapping": {
          "total_fields": {
            "limit": 2000
          },
          "ignore_malformed": true
        }
      }
    },
    "mappings": {
      "dynamic": "false",
      "date_detection": false,
      "numeric_detection": false,
      "dynamic_templates": [
        {
          "unknown_strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 8191
            }
          }
        }
      ],
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "case": {
          "type": "keyword"
        },
        "host": {
          "properties": {
            "name": {
              "type": "keyword"
            }
          }
        },
        "event": {
          "properties": {
            "dataset": {
              "type": "keyword"
            }
          }
        },
        "kape": {
          "properties": {
            "source_file": {
              "type": "keyword"
            },
            "timestamp_source": {
              "type": "keyword"
            },
            "timestamp_meaning": {
              "type": "keyword"
            }
          }
        },
        "file": {
          "properties": {
            "path": {
              "type": "keyword",
              "ignore_above": 8191,
              "fields": {
                "text": {
                  "type": "match_only_text"
                }
              }
            },
            "name": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "extension": {
              "type": "keyword"
            },
            "size": {
              "type": "long"
            },
            "created": {
              "type": "date"
            },
            "mtime": {
              "type": "date"
            },
            "hash": {
              "properties": {
                "sha1": {
                  "type": "keyword"
                }
              }
            },
            "pe": {
              "properties": {
                "company": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "description": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "file_version": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "product": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "Fields shared by every SOF-ELK Import Toolkit custom-artifact index: host, case, provenance, and the ECS file.* subset used across Amcache, ShimCache and similar artifacts",
    "provider": "SOF-ELK-Import-Toolkit",
    "version": 1
  }
}
