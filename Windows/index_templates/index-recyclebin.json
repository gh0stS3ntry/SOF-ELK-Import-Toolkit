{
  "index_patterns": [
    "recyclebin-*"
  ],
  "priority": 200,
  "composed_of": [
    "sofelk-toolkit-common"
  ],
  "template": {
    "mappings": {
      "_meta": {
        "toolkit_schema": "recyclebin",
        "toolkit_schema_version": 1
      },
      "properties": {
        "recyclebin": {
          "properties": {
            "deleted_on": {
              "type": "date"
            },
            "file_type": {
              "type": "keyword"
            },
            "malformed": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "original_path": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "source_name": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "unmapped": {
              "type": "object",
              "dynamic": "true"
            }
          }
        },
        "user": {
          "properties": {
            "id": {
              "type": "keyword"
            }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "Explicit schema for RBCmd CSV output loaded by rbcmd2sofelk.py",
    "provider": "SOF-ELK-Import-Toolkit",
    "version": 1
  }
}
