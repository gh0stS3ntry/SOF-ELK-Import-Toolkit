{
  "index_patterns": [
    "browsinghistory-*"
  ],
  "priority": 200,
  "composed_of": [
    "sofelk-toolkit-common"
  ],
  "template": {
    "mappings": {
      "_meta": {
        "toolkit_schema": "browsinghistory",
        "toolkit_schema_version": 1
      },
      "properties": {
        "browsinghistory": {
          "properties": {
            "browser_profile": {
              "type": "keyword"
            },
            "history_file": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "malformed": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "record_id": {
              "type": "long"
            },
            "title": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "typed_count": {
              "type": "long"
            },
            "url_length": {
              "type": "long"
            },
            "user_profile": {
              "type": "keyword"
            },
            "visit_count": {
              "type": "long"
            },
            "visit_duration": {
              "type": "keyword"
            },
            "visit_time": {
              "type": "date"
            },
            "visit_time_local": {
              "type": "keyword"
            },
            "visit_type": {
              "type": "keyword"
            },
            "visited_from": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "web_browser": {
              "type": "keyword"
            },
            "unmapped": {
              "type": "object",
              "dynamic": "true"
            }
          }
        },
        "url": {
          "properties": {
            "domain": {
              "type": "keyword"
            },
            "original": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "scheme": {
              "type": "keyword"
            }
          }
        },
        "user": {
          "properties": {
            "name": {
              "type": "keyword"
            }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "Explicit schema for BrowsingHistoryView CSV output loaded by nirsoft_bhv2sofelk.py",
    "provider": "SOF-ELK-Import-Toolkit",
    "version": 1
  }
}
