{
  "index_patterns": [
    "browsinghistory-*"
  ],
  "priority": 200,
  "composed_of": [
    "sofelk-toolkit-common"
  ],
  "template": {
    "mappings": {
      "_meta": {
        "toolkit_schema": "browsinghistory",
        "toolkit_schema_version": 1
      },
      "properties": {
        "browsinghistory": {
          "properties": {
            "browser_profile": {
              "type": "keyword"
            },
            "history_file": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "malformed": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "record_id": {
              "type": "long"
            },
            "title": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "typed_count": {
              "type": "long"
            },
            "url_length": {
              "type": "long"
            },
            "user_profile": {
              "type": "keyword"
            },
            "visit_count": {
              "type": "long"
            },
            "visit_duration": {
              "type": "keyword"
            },
            "visit_time": {
              "type": "date"
            },
            "visit_time_local": {
              "type": "keyword"
            },
            "visit_type": {
              "type": "keyword"
            },
            "visited_from": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "web_browser": {
              "type": "keyword"
            },
            "unmapped": {
              "type": "object",
              "dynamic": "true"
            },
            "from_visit": {
              "type": "long"
            },
            "transition": {
              "type": "long"
            },
            "transition_qualifiers": {
              "type": "keyword"
            },
            "visit_source": {
              "type": "keyword"
            },
            "hidden": {
              "type": "boolean"
            },
            "download": {
              "properties": {
                "guid": {
                  "type": "keyword"
                },
                "state": {
                  "type": "keyword"
                },
                "danger_type": {
                  "type": "keyword"
                },
                "interrupt_reason": {
                  "type": "keyword"
                },
                "mime_type": {
                  "type": "keyword"
                },
                "received_bytes": {
                  "type": "long"
                },
                "total_bytes": {
                  "type": "long"
                },
                "opened": {
                  "type": "boolean"
                },
                "deleted": {
                  "type": "boolean"
                },
                "end_time": {
                  "type": "date"
                },
                "referrer": {
                  "type": "keyword",
                  "ignore_above": 8191
                },
                "tab_url": {
                  "type": "keyword",
                  "ignore_above": 8191
                }
              }
            }
          }
        },
        "url": {
          "properties": {
            "domain": {
              "type": "keyword"
            },
            "original": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "scheme": {
              "type": "keyword"
            }
          }
        },
        "user": {
          "properties": {
            "name": {
              "type": "keyword"
            }
          }
        },
        "host": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "os": {
              "properties": {
                "type": {
                  "type": "keyword"
                },
                "name": {
                  "type": "keyword"
                },
                "version": {
                  "type": "keyword"
                },
                "full": {
                  "type": "keyword"
                },
                "platform": {
                  "type": "keyword"
                },
                "family": {
                  "type": "keyword"
                },
                "kernel": {
                  "type": "keyword"
                }
              }
            }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "Explicit schema for browsing history: NirSoft BrowsingHistoryView CSV output (nirsoft_bhv2sofelk.py) and Linux Firefox/Chromium history databases (Linux/browser2sofelk.py)",
    "provider": "SOF-ELK-Import-Toolkit",
    "version": 1
  }
}
