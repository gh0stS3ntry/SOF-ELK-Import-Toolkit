{
  "index_patterns": [
    "shimcache-*"
  ],
  "priority": 200,
  "composed_of": [
    "sofelk-toolkit-common"
  ],
  "template": {
    "mappings": {
      "_meta": {
        "toolkit_schema": "shimcache",
        "toolkit_schema_version": 1
      },
      "properties": {
        "shimcache": {
          "properties": {
            "cache_entry_position": {
              "type": "long"
            },
            "control_set": {
              "type": "long"
            },
            "duplicate": {
              "type": "boolean"
            },
            "executed": {
              "type": "keyword"
            },
            "malformed": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "path": {
              "type": "keyword",
              "ignore_above": 8191
            },
            "source_hive": {
              "type": "keyword"
            },
            "unmapped": {
              "type": "object",
              "dynamic": "true"
            }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "Explicit schema for AppCompatCacheParser CSV output loaded by shimcache2sofelk.py: ECS file.path/name/extension/mtime, shimcache.* for the rest",
    "provider": "SOF-ELK-Import-Toolkit",
    "version": 1
  }
}
