// IM-03 | Ransom notes: the same text/HTML file name in many folders ($MFT)
// Tactic: TA0040 Impact | ATT&CK: T1486, T1491.001
// Indexes: filesystem-* | Needs: MFTECmd $MFT output
FROM filesystem-* METADATA _index
| WHERE file.update_reasons IS NULL
| WHERE COALESCE(TO_STRING(file.type), "") != "dir"
| EVAL fname = TO_LOWER(COALESCE(TO_STRING(file.name), ""))
| WHERE fname RLIKE ".*[.](txt|html|htm|hta|rtf|url|png|jpg|bmp)"
| EVAL f_note_name = fname RLIKE ".*(readme|read_me|read-me|restore|recover|decrypt|how_to|how-to|howto|help_|_help|instruction|ransom|unlock|your_files|files_encrypted|!!!|attention|warning|info[.]hta|lockbit|akira|black|royal|hive|conti|ryuk|medusa|rhysida|qilin|cactus|8base|bianlian|phobos|makop|mallox).*"
| EVAL created = COALESCE(file.filename.created, file.stdinfo.created)
| STATS
    copies = COUNT(*),
    distinct_dirs = COUNT_DISTINCT(file.parent.inode),
    distinct_sizes = COUNT_DISTINCT(file.size),
    size = MAX(file.size),
    first_created = MIN(created),
    last_created = MAX(created),
    sample_paths = VALUES(file.path)
  BY _index, fname, f_note_name
| WHERE distinct_dirs >= 20 AND distinct_sizes <= 3
// filters out installer-shipped files (one per package, varying sizes) and keeps short creation bursts
| EVAL spread_minutes = DATE_DIFF("minutes", first_created, last_created)
| WHERE f_note_name OR (distinct_dirs >= 100 AND spread_minutes <= 240)
| EVAL sample_paths = MV_SLICE(sample_paths, 0, 9)
| EVAL score = CASE(f_note_name, 3, 0) + CASE(distinct_dirs >= 500, 3, distinct_dirs >= 100, 2, 1) + CASE(spread_minutes <= 60, 2, spread_minutes <= 240, 1, 0) + CASE(distinct_sizes == 1, 1, 0)
| WHERE score >= 5
| KEEP _index, score, fname, f_note_name, copies, distinct_dirs, size, first_created, last_created, spread_minutes, sample_paths
| SORT score DESC, first_created ASC
| LIMIT 2000
