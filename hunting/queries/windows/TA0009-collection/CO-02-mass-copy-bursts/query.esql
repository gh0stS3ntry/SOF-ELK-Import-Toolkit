// CO-02 | Mass copying of documents into one folder (staging bursts, $MFT)
// Tactic: TA0009 Collection | ATT&CK: T1074.001, T1005, T1039
// Indexes: filesystem-* | Needs: MFTECmd $MFT output
FROM filesystem-* METADATA _index
| WHERE file.update_reasons IS NULL
| WHERE COALESCE(TO_STRING(file.type), "") != "dir"
| EVAL fname = TO_LOWER(COALESCE(TO_STRING(file.name), ""))
| WHERE fname != ""
| EVAL p = TO_LOWER(COALESCE(TO_STRING(file.path), TO_STRING(file.directory), ""))
| EVAL tier = CASE(
    p RLIKE ".*\\\\(users\\\\public|programdata|perflogs|windows\\\\temp|[$]recycle[.]bin|windows\\\\debug|windows\\\\tasks|windows\\\\tracing|spool\\\\drivers\\\\color)\\\\.*", "high-risk staging dir",
    p RLIKE ".*\\\\users\\\\[^\\\\]+\\\\(appdata\\\\(local|roaming)|downloads|desktop|music|pictures|videos|onedrive)(\\\\.*)?", "user-writable dir",
    null
  )
| WHERE tier IS NOT NULL
| WHERE NOT p RLIKE ".*(package cache|softwaredistribution|\\\\winsxs|\\\\servicing|windowsapps|\\\\microsoft\\\\edge|\\\\google\\\\chrome|\\\\mozilla|\\\\windows\\\\installer|\\\\windows\\\\wer\\\\|\\\\appdata\\\\local\\\\packages|\\\\appdata\\\\local\\\\microsoft).*"
| EVAL event_time = COALESCE(file.filename.created, file.stdinfo.created)
| WHERE event_time IS NOT NULL
| EVAL dir = TO_LOWER(COALESCE(TO_STRING(file.directory), REPLACE(TO_STRING(file.path), "\\\\[^\\\\]*$", ""), ""))
| EVAL bucket = DATE_TRUNC(10 minutes, event_time)
| EVAL ext = TO_LOWER(COALESCE(TO_STRING(file.extension), ""))
| EVAL f_doc = fname RLIKE ".*[.](docx?|xlsx?|xlsm|pptx?|pdf|txt|rtf|csv|odt|ods|msg|eml|vsdx?)"
| EVAL f_sens = fname RLIKE ".*[.](pst|ost|kdbx|kdb|pem|pfx|p12|ppk|key|rdp|sql|mdb|accdb|bak|vmdk|ovpn|config)"
| EVAL f_copy = COALESCE(file.stdinfo.mtime < file.stdinfo.created, false)
| STATS
    files = COUNT(*),
    doc_files = COUNT(*) WHERE f_doc,
    sensitive_files = COUNT(*) WHERE f_sens,
    copied_files = COUNT(*) WHERE f_copy,
    distinct_ext = COUNT_DISTINCT(ext),
    total_mb = ROUND(TO_DOUBLE(SUM(file.size)) / 1048576.0, 1),
    first_created = MIN(event_time),
    last_created = MAX(event_time),
    first_file = MIN(fname),
    last_file = MAX(fname)
  BY _index, dir, tier, bucket
| WHERE doc_files + sensitive_files >= 25 OR files >= 200
| EVAL copy_ratio = ROUND(TO_DOUBLE(copied_files) / TO_DOUBLE(files), 2)
| KEEP
    _index,
    bucket,
    tier,
    dir,
    files,
    doc_files,
    sensitive_files,
    copied_files,
    copy_ratio,
    distinct_ext,
    total_mb,
    first_created,
    last_created,
    first_file,
    last_file
| SORT doc_files DESC, files DESC, bucket ASC
| LIMIT 2000
