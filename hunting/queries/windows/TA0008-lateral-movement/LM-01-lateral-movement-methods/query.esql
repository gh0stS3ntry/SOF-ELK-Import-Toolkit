// LM-01 | Lateral movement via RDP, SMB, PsExec-style services, WinRM and WMI (inbound and outbound)
// Tactic: TA0008 Lateral Movement | ATT&CK: T1021.001, T1021.002, T1021.006, T1047, T1569.002, T1550
// Indexes: evtxlogs-* | Needs: Security 4624/4648/5140; RDP, SMB client, WinRM, PowerShell and WMI-Activity Operational logs as available
FROM evtxlogs-* METADATA _index
| EVAL eid = TO_STRING(winlog.event_id)
| EVAL ch = TO_STRING(winlog.channel)
| WHERE (ch == "Security" AND eid IN ("4624", "4648", "4778", "4779", "5140", "5145"))
     OR (ch == "Microsoft-Windows-TerminalServices-RemoteConnectionManager/Operational" AND eid == "1149")
     OR (ch == "Microsoft-Windows-TerminalServices-LocalSessionManager/Operational" AND eid IN ("21", "22", "25", "41"))
     OR (ch == "Microsoft-Windows-RemoteDesktopServices-RdpCoreTS/Operational" AND eid IN ("98", "131"))
     OR (ch == "Microsoft-Windows-TerminalServices-RDPClient/Operational" AND eid IN ("1024", "1102"))
     OR (ch == "Microsoft-Windows-SmbClient/Security" AND eid == "31001")
     OR (ch == "Microsoft-Windows-WinRM/Operational" AND eid IN ("6", "8", "15", "16", "33", "91", "142", "161", "169"))
     OR (ch == "Windows PowerShell" AND eid IN ("400", "403", "800"))
     OR (ch == "Microsoft-Windows-PowerShell/Operational" AND eid IN ("8193", "8194", "8197", "40961", "40962", "53504"))
     OR (ch == "Microsoft-Windows-WMI-Activity/Operational" AND eid IN ("5857", "5858", "5860", "5861"))
     OR (ch == "System" AND eid IN ("7045", "7034", "7035", "7036"))
     OR (ch == "Security" AND eid == "4697")
| EVAL txt = TO_LOWER(CONCAT(
    COALESCE(TO_STRING(message), ""), " ",
    COALESCE(TO_STRING(kape.executable_info), ""), " ",
    COALESCE(TO_STRING(kape.map_description), ""), " ",
    COALESCE(TO_STRING(`winlog.payload.event_data.ServiceName`), ""), " ",
    COALESCE(TO_STRING(`winlog.payload.event_data.ServiceFileName`), ""), " ",
    COALESCE(TO_STRING(`winlog.payload.event_data.param1`), ""), " ",
    COALESCE(TO_STRING(`winlog.payload.user_data.Operation_ClientFailure.Operation`), "")))
// 7045 ExecutableInfo is the service binary; 4697 is added for hosts with Security System Extension auditing;
// 7034/7035/7036 carry the service name in param1
| EVAL lt = TO_STRING(`winlog.payload.event_data.LogonType`)
| EVAL auth_pkg = TO_LOWER(COALESCE(TO_STRING(`winlog.payload.event_data.AuthenticationPackageName`), ""))
| EVAL acct = COALESCE(TO_STRING(`winlog.payload.event_data.TargetUserName`), TO_STRING(`winlog.payload.event_data.AccountName`), TO_STRING(`winlog.payload.event_data.UserName`), TO_STRING(`winlog.payload.user_data.EventXML.User`), TO_STRING(`winlog.payload.user_data.EventXML.Param1`), "")
| EVAL actor = COALESCE(TO_STRING(`winlog.payload.event_data.SubjectUserName`), "")
| EVAL src_ip = COALESCE(TO_STRING(`winlog.payload.event_data.IpAddress`), TO_STRING(`winlog.payload.event_data.ClientIP`), TO_STRING(`winlog.payload.event_data.ClientAddress`), TO_STRING(`winlog.payload.user_data.EventXML.Address`), TO_STRING(remote.ip), "")
| EVAL tgt = TO_LOWER(COALESCE(TO_STRING(`winlog.payload.event_data.TargetServerName`), TO_STRING(`winlog.payload.event_data.ServerName`), TO_STRING(`winlog.payload.user_data.EventXML.ServerName`),TO_STRING(`winlog.payload.event_data.Value`), ""))
| EVAL share = TO_LOWER(COALESCE(TO_STRING(`winlog.payload.event_data.ShareName`), ""))
| EVAL client_machine = TO_LOWER(COALESCE(TO_STRING(`winlog.payload.user_data.Operation_ClientFailure.ClientMachine`), TO_STRING(`winlog.payload.event_data.ClientName`), ""))
| EVAL provider_path = TO_LOWER(COALESCE(TO_STRING(`winlog.payload.user_data.Operation_StartedOperational.ProviderPath`), ""))
| EVAL comp = TO_LOWER(MV_FIRST(SPLIT(COALESCE(TO_STRING(winlog.computer_name), ""), ".")))
| EVAL f_remote_src = src_ip != ""
    AND NOT TO_LOWER(src_ip) IN ("-", "::1", "127.0.0.1", "local", "localhost", "unknown")
    AND NOT TO_LOWER(src_ip) LIKE "::ffff:127.*"
| EVAL f_machine_or_anon = acct LIKE "*$" OR TO_LOWER(acct) == "anonymous logon"
| EVAL f_logon_rdp = eid == "4624" AND lt == "10" AND f_remote_src
| EVAL f_logon_net = eid == "4624" AND lt == "3" AND f_remote_src
| EVAL f_logon_ntlm = f_logon_net AND auth_pkg == "ntlm"
| EVAL f_explicit_remote = eid == "4648" AND tgt != "" AND tgt != "localhost" AND tgt != "-"
    AND NOT (comp != "" AND STARTS_WITH(tgt, comp))
// RDP, inbound
| EVAL f_rdp_in = ch LIKE "*RemoteConnectionManager*" AND eid == "1149"
// a 1149 with no user name: the logon screen was reached without authenticating (Sticky Keys / Utilman backdoors)
| EVAL f_rdp_blank_user = f_rdp_in AND TRIM(acct) IN ("", "-")
| EVAL f_rdp_session = ch LIKE "*LocalSessionManager*" AND eid IN ("21", "22", "25") AND f_remote_src
| EVAL f_rdp_net = ch LIKE "*RdpCoreTS*" AND eid == "131" AND f_remote_src
| EVAL f_rdp_reconnect = ch == "Security" AND eid IN ("4778", "4779") AND f_remote_src
// LocalSessionManager 41 and RdpCoreTS 98 carry no source address: kept on hosts that also show inbound RDP
| EVAL f_rdp_ctx = (ch LIKE "*LocalSessionManager*" AND eid == "41") OR (ch LIKE "*RdpCoreTS*" AND eid == "98")
// RDP, outbound
| EVAL f_rdp_out = ch LIKE "*RDPClient*"
// SMB
| EVAL f_admin_share = eid IN ("5140", "5145") AND share RLIKE ".*(admin[$]|[\\\\][a-z][$])"
| EVAL f_pipe = eid == "5145" AND txt RLIKE ".*(svcctl|atsvc|psexesvc|remcom|paexec|csexec|winreg|samr|lsarpc).*"
| EVAL f_smb_client_fail = ch == "Microsoft-Windows-SmbClient/Security" AND eid == "31001"
| EVAL f_psexec_svc = eid IN ("7045", "4697", "7034", "7035", "7036")
    AND txt RLIKE ".*(psexesvc|paexec|remcomsvc|csexec|winexesvc|[\\\\][\\\\]127[.]0[.]0[.]1[\\\\]admin[$]|%comspec%).*"
// WinRM and PowerShell remoting, inbound
| EVAL f_winrm_srv = ch == "Microsoft-Windows-WinRM/Operational" AND eid IN ("91", "169")
| EVAL f_winrm_srv_fail = ch == "Microsoft-Windows-WinRM/Operational" AND eid == "142"
| EVAL f_ps_remote = ch == "Windows PowerShell" AND eid IN ("400", "403", "800") AND txt RLIKE ".*(wsmprovhost|serverremotehost).*"
| EVAL f_ps_ipc = ch == "Microsoft-Windows-PowerShell/Operational" AND eid == "53504"
// WinRM and PowerShell remoting, outbound
| EVAL f_winrm_cli = ch == "Microsoft-Windows-WinRM/Operational" AND eid == "6"
    AND NOT txt RLIKE ".*(localhost|127[.]0[.]0[.]1).*"
| EVAL f_winrm_cli_fail = ch == "Microsoft-Windows-WinRM/Operational" AND eid == "161"
| EVAL f_winrm_cli_close = ch == "Microsoft-Windows-WinRM/Operational" AND eid IN ("8", "15", "16", "33")
| EVAL f_ps_runspace = ch == "Microsoft-Windows-PowerShell/Operational" AND eid IN ("8193", "8194", "8197")
| EVAL f_ps_console = ch == "Microsoft-Windows-PowerShell/Operational" AND eid IN ("40961", "40962")
// WMI
| EVAL f_wmi_remote = eid == "5858" AND client_machine != "" AND client_machine != comp
    AND client_machine != "localhost" AND client_machine != "-"
| EVAL f_wmi_sub = eid IN ("5860", "5861")
| EVAL f_wmi_proc = ch == "Microsoft-Windows-WMI-Activity/Operational"
    AND txt RLIKE ".*(win32_process|win32_service|win32_scheduledjob|__eventfilter|commandlineeventconsumer).*"
// 5857 is logged for every provider load; only providers outside the Windows folders are kept
| EVAL f_wmi_provider = eid == "5857" AND provider_path != ""
    AND NOT provider_path RLIKE "(%systemroot%|%windir%|[a-z]:[\\\\]windows)[\\\\](system32|syswow64)[\\\\].*"
// host context for the events that carry no address on their own
| INLINE STATS
    host_rdp_in = COUNT(*) WHERE f_rdp_in OR f_rdp_session OR f_rdp_net OR f_rdp_reconnect OR f_logon_rdp,
    host_remoting_in = COUNT(*) WHERE f_winrm_srv OR f_ps_remote,
    host_remoting_out = COUNT(*) WHERE f_winrm_cli OR f_winrm_cli_fail
  BY _index
| EVAL score = CASE(f_rdp_out, 3, 0)
    + CASE(f_rdp_in, 3, 0)
    + CASE(f_rdp_blank_user, 3, 0)
    + CASE(f_rdp_session, 3, 0)
    + CASE(f_rdp_net, 3, 0)
    + CASE(f_rdp_reconnect, 3, 0)
    + CASE(f_rdp_ctx, 2, 0) + CASE(f_rdp_ctx AND host_rdp_in > 0, 1, 0)
    + CASE(f_logon_rdp, 3, 0)
    + CASE(f_logon_net, 1, 0)
    + CASE(f_logon_ntlm, 1, 0)
    + CASE(f_explicit_remote, 3, 0)
    + CASE(f_admin_share, 3, 0)
    + CASE(f_pipe, 3, 0)
    + CASE(f_smb_client_fail, 3, 0)
    + CASE(f_psexec_svc, 4, 0)
    + CASE(f_winrm_srv, 3, 0)
    + CASE(f_winrm_srv_fail, 3, 0)
    + CASE(f_ps_remote, 3, 0)
    + CASE(f_ps_ipc, 2, 0) + CASE(f_ps_ipc AND host_remoting_in > 0, 1, 0)
    + CASE(f_winrm_cli, 3, 0)
    + CASE(f_winrm_cli_fail, 3, 0)
    + CASE(f_winrm_cli_close OR f_ps_runspace OR f_ps_console, 2, 0)
    + CASE((f_winrm_cli_close OR f_ps_runspace OR f_ps_console) AND host_remoting_out > 0, 1, 0)
    + CASE(f_wmi_remote, 3, 0)
    + CASE(f_wmi_sub, 2, 0)
    + CASE(f_wmi_proc, 1, 0)
    + CASE(f_wmi_provider, 3, 0)
    + CASE(f_machine_or_anon AND eid IN ("4624", "5140", "5145"), -2, 0)
| WHERE score >= 3
| EVAL method = CASE(
    ch LIKE "*TerminalServices*" OR ch LIKE "*RdpCoreTS*" OR eid IN ("4778", "4779") OR (eid == "4624" AND lt == "10"), "RDP",
    eid IN ("5140", "5145") OR ch == "Microsoft-Windows-SmbClient/Security", "SMB",
    ch == "Microsoft-Windows-WinRM/Operational" OR ch == "Windows PowerShell" OR ch == "Microsoft-Windows-PowerShell/Operational", "WinRM / PowerShell remoting",
    ch == "Microsoft-Windows-WMI-Activity/Operational", "WMI",
    eid IN ("7045", "4697", "7034", "7035", "7036"), "SMB/SCM (PsExec-style service)",
    eid == "4648", "Explicit credentials (outbound)",
    eid == "4624", "Network logon (SMB/WMI/WinRM/other)",
    "Other"
  )
| EVAL direction = CASE(
    f_rdp_out OR eid == "4648" OR f_smb_client_fail OR f_winrm_cli OR f_winrm_cli_fail OR f_winrm_cli_close OR f_ps_runspace OR f_ps_console,
    "Outbound (from this host)", "Inbound (to this host)")
| EVAL reasons = REPLACE(CONCAT(
    CASE(f_rdp_out, "outbound RDP client connection; ", ""),
    CASE(f_rdp_in, "RDP user authenticated (1149); ", ""),
    CASE(f_rdp_blank_user, "1149 with blank user name (Sticky Keys / accessibility backdoor?); ", ""),
    CASE(f_rdp_session, "RDP session from remote address; ", ""),
    CASE(f_rdp_net, "RDP TCP connection accepted (131); ", ""),
    CASE(f_rdp_reconnect, "RDP session reconnected/disconnected (4778/4779); ", ""),
    CASE(f_rdp_ctx, "RDP session arbitration (41) / connection established (98); ", ""),
    CASE(f_logon_rdp, "remote interactive logon (type 10); ", ""),
    CASE(f_logon_net, "network logon from remote IP (type 3); ", ""),
    CASE(f_logon_ntlm, "NTLM network logon; ", ""),
    CASE(f_explicit_remote, "explicit credentials to another server; ", ""),
    CASE(f_admin_share, "admin share (ADMIN$/C$) access; ", ""),
    CASE(f_pipe, "service/registry/SAM named pipe over SMB; ", ""),
    CASE(f_smb_client_fail, "failed logon to a remote share (SmbClient 31001); ", ""),
    CASE(f_psexec_svc, "PsExec-style service install/start/stop/crash; ", ""),
    CASE(f_winrm_srv, "WinRM session on this host; ", ""),
    CASE(f_winrm_srv_fail, "WinRM operation failure on this host (142); ", ""),
    CASE(f_ps_remote, "PowerShell remoting host (wsmprovhost) start/stop/pipeline; ", ""),
    CASE(f_ps_ipc, "PowerShell IPC listener (53504); ", ""),
    CASE(f_winrm_cli, "outbound WinRM session; ", ""),
    CASE(f_winrm_cli_fail, "outbound WinRM authentication error (161); ", ""),
    CASE(f_winrm_cli_close, "WinRM session closed (8/15/16/33); ", ""),
    CASE(f_ps_runspace, "PowerShell remoting runspace created/closed (8193/8194/8197); ", ""),
    CASE(f_ps_console, "PowerShell console started (40961/40962); ", ""),
    CASE(f_wmi_remote, "remote WMI client machine; ", ""),
    CASE(f_wmi_sub, "WMI event subscription; ", ""),
    CASE(f_wmi_proc, "WMI process/service/subscription class; ", ""),
    CASE(f_wmi_provider, "WMI provider DLL outside System32 (5857); ", "")
  ), "; $", "")
| EVAL detail = COALESCE(TO_STRING(kape.executable_info), TO_STRING(message), "")
| KEEP
    _index,
    @timestamp,
    winlog.computer_name,
    direction,
    method,
    winlog.channel,
    eid,
    score,
    reasons,
    acct,
    actor,
    src_ip,
    tgt,
    share,
    lt,
    auth_pkg,
    client_machine,
    provider_path,
    detail
| SORT score DESC, @timestamp ASC
| LIMIT 10000
