// EX-15 | Execution evidence for named files across Amcache, ShimCache and SRUM (pivot)
// Tactic: TA0002 Execution | ATT&CK: T1204.002
// Indexes: amcache-*, shimcache-*, srum-* | Needs: any of the three
FROM amcache-*, shimcache-*, srum-* METADATA _index
| EVAL p = TO_LOWER(COALESCE(file.path, process.executable, srum.exe_info, ""))
// EDIT: the file names, partial paths or hashes you are pivoting on
| WHERE p RLIKE ".*\\\\(wabmailpv|epdevmgr)[.](exe|dll)"
     OR file.hash.sha1 IN ("0000000000000000000000000000000000000000")
| EVAL artifact = REPLACE(_index, "-.*$", "")
| EVAL ts = COALESCE(amcache.file_key_last_write, amcache.key_last_write, file.mtime, srum.timestamp)
| EVAL ts_meaning = CASE(
    artifact == "amcache", "Amcache file key last write (close to first execution)",
    artifact == "shimcache", "file $SI modified time recorded by ShimCache (not execution)",
    "SRUM record time (program active in the preceding hour)")
| KEEP
    _index,
    artifact,
    ts,
    ts_meaning,
    p,
    file.hash.sha1,
    file.size,
    file.pe.product,
    file.pe.description,
    amcache.link_date,
    amcache.program_id,
    shimcache.executed,
    shimcache.cache_entry_position,
    user.name,
    srum.foreground_bytes_written,
    srum.background_bytes_written,
    kape.source_file
| SORT artifact ASC, ts ASC
| LIMIT 2000
