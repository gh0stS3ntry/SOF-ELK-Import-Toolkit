// CA-09 | SQL Server failed logins (Application 18456), by client and login
// Tactic: TA0006 Credential Access | ATT&CK: T1110.001, T1110.003
// Indexes: evtxlogs-* | Needs: Application log from the SQL Server host
FROM evtxlogs-* METADATA _index
| WHERE TO_STRING(winlog.channel) == "Application"
| EVAL prov = TO_LOWER(COALESCE(TO_STRING(winlog.provider_name), ""))
| WHERE prov LIKE "mssql*"
| EVAL eid = TO_STRING(winlog.event_id)
| WHERE eid IN ("18456", "18453", "18454", "18455")
| EVAL txt = COALESCE(MV_CONCAT(winlog.payload.event_data.string, " | "), "")
// "Login failed for user 'sa'. Reason: Password did not match ... [CLIENT: 10.1.2.3]"
| EVAL login = REPLACE(txt, "(?s)^.*(?:for user|succeeded for user) '([^']*)'.*$", "$1")
| EVAL client = REPLACE(txt, "(?s)^.*\\[CLIENT: ([^\\]]+)\\].*$", "$1")
| EVAL reason = CASE(eid == "18456", REPLACE(txt, "(?s)^.*Reason: ([^.\\[]+).*$", "$1"), "login succeeded")
| EVAL outcome = CASE(eid == "18456", "failure", "success")
| EVAL time_bucket = DATE_TRUNC(1 hour, @timestamp)
| STATS
    events = COUNT(*),
    failures = COUNT(*) WHERE outcome == "failure",
    successes = COUNT(*) WHERE outcome == "success",
    logins = VALUES(login),
    reasons = VALUES(reason),
    first_seen = MIN(@timestamp),
    last_seen = MAX(@timestamp)
  BY _index, client, time_bucket
| EVAL f_brute = failures >= 20
| EVAL f_success_with_fail = failures >= 5 AND successes > 0
| EVAL logins = MV_SLICE(logins, 0, 29)
| KEEP
    _index,
    time_bucket,
    client,
    failures,
    successes,
    f_brute,
    f_success_with_fail,
    logins,
    reasons,
    first_seen,
    last_seen
| SORT f_success_with_fail DESC, failures DESC
| LIMIT 5000
