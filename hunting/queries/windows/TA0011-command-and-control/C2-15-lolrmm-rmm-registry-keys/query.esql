        OR key LIKE "*\\\\services\\\\tiservice"
        OR key LIKE "*\\\\services\\\\tiservice\\\\*"
        OR key LIKE "*\\\\services\\\\tiservice\\\\imagepath"
        OR key LIKE "*\\\\services\\\\tiservice\\\\imagepath\\\\*"
        OR key LIKE "*\\\\services\\\\tiservice\\\\start"
        OR key LIKE "*\\\\services\\\\tiservice\\\\start\\\\*"
        OR key LIKE "*\\\\software\\\\tiflux"
        OR key LIKE "*\\\\software\\\\tiflux\\\\*"
        OR key LIKE "*\\\\tiflux\\\\*"
        OR key LIKE "*\\\\tiflux\\\\org_id"
        OR key LIKE "*\\\\tiflux\\\\org_id\\\\*"), "TiFLUX",
    (key LIKE "*\\\\classes\\\\appid\\\\trustconnectagent.exe"
        OR key LIKE "*\\\\classes\\\\appid\\\\trustconnectagent.exe\\\\*"
        OR key LIKE "*\\\\microsoft\\\\windows\\\\currentversion\\\\run\\\\trustconnectagent_*"
        OR key LIKE "*\\\\microsoft\\\\windows\\\\currentversion\\\\uninstall\\\\trustconnect agent"
        OR key LIKE "*\\\\microsoft\\\\windows\\\\currentversion\\\\uninstall\\\\trustconnect agent\\\\*"
        OR key LIKE "*\\\\services\\\\trustconnect agent"
        OR key LIKE "*\\\\services\\\\trustconnect agent\\\\*"), "TrustConnect",
    (key LIKE "*\\\\services\\\\veyonservice"
        OR key LIKE "*\\\\services\\\\veyonservice\\\\*"
        OR key LIKE "*\\\\veyon solutions"
        OR key LIKE "*\\\\veyon solutions\\\\*"), "Veyon",
    (key LIKE "*\\\\metaquest"
        OR key LIKE "*\\\\metaquest\\\\*"
        OR key LIKE "*\\\\microsoft\\\\windows\\\\currentversion\\\\uninstall\\\\{04821777-1fd1-4c1a-ac4d-bf5d4d53c34c}"
        OR key LIKE "*\\\\microsoft\\\\windows\\\\currentversion\\\\uninstall\\\\{04821777-1fd1-4c1a-ac4d-bf5d4d53c34c}\\\\*"
        OR key LIKE "*\\\\microsoft\\\\windows\\\\currentversion\\\\uninstall\\\\{a40a237d-c090-4c05-8580-9dbecfe3602b}"
        OR key LIKE "*\\\\microsoft\\\\windows\\\\currentversion\\\\uninstall\\\\{a40a237d-c090-4c05-8580-9dbecfe3602b}\\\\*"), "VIZOR",
    (key LIKE "*\\\\zecurit\\\\agent"
        OR key LIKE "*\\\\zecurit\\\\agent\\\\*"), "Zecurit",
    "")
| WHERE COALESCE(tool, "") != ""
| STATS
    events = COUNT(*),
    first_seen = MIN(ts),
    last_seen = MAX(ts),
    values = VALUES(value),
    data = VALUES(data),
    programs = VALUES(program)
  BY _index, tool, source, k
| INLINE STATS tool_hosts = COUNT_DISTINCT(_index) BY tool
| EVAL f_event = source != "RECmd batch"
| EVAL f_policy_or_boot = k RLIKE ".*\\\\(safeboot|policies|services|run|runonce)\\\\.*"
| EVAL score = 2 + CASE(f_event, 1, 0) + CASE(f_policy_or_boot, 1, 0) + CASE(tool_hosts == 1, 1, 0)
| EVAL values = MV_SLICE(values, 0, 19)
| EVAL data = MV_SLICE(data, 0, 19)
| KEEP
    _index,
    score,
    tool,
    source,
    k,
    events,
    first_seen,
    last_seen,
    values,
    data,
    programs,
    tool_hosts
| SORT score DESC, first_seen ASC
| LIMIT 10000
