// C2-05 | Remote access (RMM) and tunnelling tools in execution artifacts
// Tactic: TA0011 Command and Control | ATT&CK: T1219, T1572, T1090
// Indexes: amcache-*, shimcache-*, srum-* | Needs: any of the three
FROM amcache-*, shimcache-*, srum-* METADATA _index
| EVAL exe_path = TO_LOWER(COALESCE(file.path, process.executable, ""))
| EVAL exe_name = REPLACE(exe_path, "^.*\\\\", "")
| EVAL product = TO_LOWER(COALESCE(file.pe.product, ""))
| EVAL tool = CASE(
    exe_name RLIKE "anydesk.*[.]exe" OR product LIKE "*anydesk*", "AnyDesk",
    exe_name RLIKE "teamviewer.*[.]exe|tv_(w32|x64)[.]exe" OR product LIKE "*teamviewer*", "TeamViewer",
    exe_name RLIKE "(screenconnect|connectwisecontrol).*[.]exe" OR product LIKE "*screenconnect*", "ScreenConnect / ConnectWise Control",
    exe_name RLIKE "(ateraagent|agentpackage.*)[.]exe" OR product LIKE "*atera*", "Atera",
    exe_name RLIKE "(splashtop|srservice|srmanager|strwinclt).*[.]exe" OR product LIKE "*splashtop*", "Splashtop",
    exe_name RLIKE "rustdesk.*[.]exe", "RustDesk",
    exe_name == "client32.exe" OR product LIKE "*netsupport*", "NetSupport Manager",
    exe_name RLIKE "meshagent.*[.]exe", "MeshCentral agent",
    exe_name RLIKE "(tacticalrmm|tacticalagent)[.]exe", "Tactical RMM",
    exe_name RLIKE "action1.*[.]exe", "Action1",
    exe_name RLIKE "(simplehelp|simpleservice|remote access)[.]exe" OR product LIKE "*simplehelp*", "SimpleHelp",
    exe_name RLIKE "(radmin|rserver3)[.]exe", "Radmin",
    exe_name RLIKE "ultraviewer.*[.]exe", "UltraViewer",
    exe_name RLIKE "(logmein|lmiguardian|lmi_rescue).*[.]exe", "LogMeIn",
    exe_name RLIKE "(g2ax_|gotoassist|goto).*[.]exe", "GoTo",
    exe_name RLIKE "(zohoassist|zaservice|zohomeeting).*[.]exe", "Zoho Assist",
    exe_name RLIKE "dwagent.*[.]exe", "DWService",
    exe_name == "remoting_host.exe", "Chrome Remote Desktop",
    exe_name RLIKE "ngrok.*[.]exe", "ngrok",
    exe_name RLIKE "(cloudflared)[.]exe", "Cloudflare tunnel",
    exe_name RLIKE "(chisel|frpc|frps|ligolo.*|gost|revsocks|rsocx|iox|stowaway)[.]exe", "tunnel / SOCKS proxy",
    exe_name RLIKE "(plink|putty|klink)[.]exe", "PuTTY / plink",
    exe_name RLIKE "(tor|obfs4proxy)[.]exe", "Tor",
    null)
| WHERE tool IS NOT NULL
| EVAL artifact = REPLACE(_index, "-.*$", "")
| EVAL ts = COALESCE(amcache.file_key_last_write, file.mtime, srum.timestamp)
| EVAL exe_norm = REPLACE(exe_path, "^(\\\\device\\\\harddiskvolume[0-9]+|[a-z]:)", "")
| EVAL f_odd_path = exe_path RLIKE ".*\\\\(users\\\\public|programdata|perflogs|windows\\\\temp|temp|appdata|downloads|[$]recycle[.]bin)\\\\.*"
| STATS
    host_count = COUNT_DISTINCT(_index),
    artifacts = VALUES(artifact),
    users = VALUES(user.name),
    in_odd_path = MAX(TO_INTEGER(f_odd_path)),
    sha1_values = VALUES(file.hash.sha1),
    first_seen = MIN(ts),
    last_seen = MAX(ts),
    source_indices = VALUES(_index)
  BY tool, exe_name, exe_norm
| EVAL score = CASE(tool IN ("ngrok", "Cloudflare tunnel", "tunnel / SOCKS proxy", "Tor"), 4, 2) + in_odd_path * 2 + CASE(host_count == 1, 1, 0)
| KEEP source_indices, host_count, score, tool, exe_name, artifacts, users, in_odd_path, first_seen, last_seen, sha1_values, exe_norm
| SORT score DESC, first_seen ASC
| LIMIT 2000
