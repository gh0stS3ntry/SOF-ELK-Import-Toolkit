        OR s3 == "api.remote.it"
        OR s4 == "auth.api.remote.it"), "Remote.it",
    s3 == "app-af-agent-prod-009.azurewebsites.net", "RemoteAgentAgent",
    s2 IN ("remotecall.com", "startsupport.com"), "RemoteCall",
    s2 == "remotepass.com", "RemotePass",
    (s2 IN ("remotedesktop.com", "remotepc.com")
        OR s3 == "www.remotepc.com"), "RemotePC",
    (s2 == "remotepulse.io"
        OR s3 == "www.remotepulse.io"), "RemotePulse",
    s2 == "remoteutilities.com", "RemoteUtilities",
    (s2 == "rview.com"
        OR s3 == "content.rview.com"), "RemoteView",
    s3 IN ("api.remsupp.com", "download.remsupp.com"), "RemSupp",
    s3 IN ("api.rg-supervision.com", "dashboard.rg-supervision.com", "lisa.rg-supervision.com"), "RG System (RG Supervision)",
    s2 == "softbymade.top", "RMMCRAT",
    s3 == "api.rmmmax.com", "RMMmax",
    (s2 == "rodex.cc"
        OR s3 == "www.rodex.cc"), "Rodex RMM",
    s2 == "royalapps.com", "Royal Server / Royal TS",
    s2 == "rport.io", "RPort",
    s2 == "rudesktop.ru", "RuDesktop",
    s2 == "runsmart.io", "RunSmart",
    (s2 == "rustdesk.com"
        OR s3 IN ("api.rustdesk.com", "rs-ny.rustdesk.com", "web.rustdesk.com")), "RustDesk",
    (s2 == "screenconnect.com"
        OR h LIKE "instance-*-relay.screenconnect.com"), "ScreenConnect",
    s2 IN ("screenmeet.com", "scrn.mt"), "ScreenMeet",
    s3 == "seetrol.co.kr", "Seetrol",
    s2 == "senso.cloud", "Senso.cloud",
    s2 == "server-eye.de", "ServerEye",
    s2 == "set.me", "SetMe PRO",
    (s2 == "shellhub.io"
        OR s3 IN ("cloud.shellhub.io", "www.shellhub.io")), "ShellHub",
    s2 == "showmypc.com", "ShowMyPC",
    s2 IN ("dronemaker.org", "microuptime.com", "simple-help.com", "telesupportgroup.com"), "SimpleHelp",
    (h LIKE "plus*.site24x7.cn"
        OR h LIKE "plus*.site24x7.com"
        OR h LIKE "plus*.site24x7.eu"
        OR h LIKE "plus*.site24x7.in"), "Site24x7",
    s2 IN ("deskroll.com", "skyfex.com"), "SkyFex",
    s2 IN ("sophos.com", "sophosupd.com", "sophosupd.net"), "Sophos-Remote Management System",
    s2 == "sorillus.com", "Sorillus",
    s2 == "splashtop.com", "Splashtop / Splashtop (Beta) / Splashtop Remote",
    s3 IN ("api.splashtop.com", "api.splashtop.eu", "relay.splashtop.com"), "Splashtop Remote",
    s2 IN ("spyanywhere.com", "spytech-web.com"), "SpyAnywhere",
    s3 IN ("client.oray.net", "sunlogin.oray.com"), "SunLogin",
    (s2 IN ("superops.ai", "superopsalpha.com", "superopsbeta.com")
        OR s3 == "serv.superopsalpha.com"), "SuperOps",
    s2 == "supremocontrol.com", "Supremo",
    (s2 IN ("kabutoservices.com", "repairshopr.com", "servably.com", "syncroapi.com", "syncromsp.com")
        OR s3 IN ("app.kabuto.io", "attachments.servably.com", "ld.aurelius.host")), "Syncro",
    s2 == "syspectr.com", "Syspectr",
    s3 IN ("docs.tacticalrmm.com", "login.tailscale.com"), "Tactical RMM",
    s2 IN ("tailscale.com", "tailscale.io"), "Tailscale",
    s3 == "cloud.tanium.com", "Tanium",
    (s2 == "teamviewer.com"
        OR s3 IN ("client.teamviewer.com", "router15.teamviewer.com", "taf.teamviewer.com")), "TeamViewer",
    s2 == "tele-desk.com", "TeleDesktop",
    (s2 == "teleport.sh"
        OR s3 IN ("cdn.teleport.dev", "reporting-connect.teleportinfra.sh", "usage.teleport.dev")), "Teleport Connect",
    (s2 == "teramind.co"
        OR s3 IN ("rt.teramind.co", "www.teramind.co")
        OR s4 == "sentry.dev.teramind.co"), "Teramind",
    (s2 == "tiflux.com"
        OR s3 IN ("agent.tiflux.com", "app.tiflux.com", "my.splashtop.com", "tiflux.com.br", "www.tiflux.com")
        OR s4 == "www.tiflux.com.br"), "TiFLUX",
    s2 == "tightvnc.com", "TightVNC",
    s2 == "tmate.io", "tmate",
    s2 == "todesk.com", "ToDesk",
    s2 IN ("networkservice.cyou", "trustconnectsoftware.com"), "TrustConnect",
    s2 == "ultraviewer.net", "UltraViewer",
    s2 == "ultravnc.com", "UltraVNC",
    (s2 == "vicarius.cloud"
        OR s3 == "vicarius-static-organizationinstallations.vicarius-cdn.com"
        OR s5 IN (
        "vicarius-ap-southeast-3-installer.s3.ap-southeast-3.amazonaws.com",
        "vicarius-ap-southeast-3-patches.s3.ap-southeast-3.amazonaws.com",
        "vicarius-ap-southeast-3-release.s3.ap-southeast-3.amazonaws.com",
        "vicarius-eu-central-1-installer.s3.eu-central-1.amazonaws.com",
        "vicarius-eu-central-1-patches.s3.eu-central-1.amazonaws.com",
        "vicarius-eu-central-1-release.s3.eu-central-1.amazonaws.com", "vicarius-release.s3.us-east-1.amazonaws.com")), "Vicarius vRx",
    (s2 == "devtunnels.ms"
        OR s5 == "rel.tunnels.api.visualstudio.com"), "Visual Studio Dev Tunnel",
    (s2 IN ("metaquest.com", "vector-networks.com", "vizor.cloud")
        OR s3 IN (
        "downloads.vector-networks.com", "mail.metaquest.com", "www.metaquest.com", "www.vector-networks.com",
        "www.vizor.cloud")), "VIZOR",
    s6 == "global.rel.tunnels.api.visualstudio.com", "VS Code Remote Tunnels / Visual Studio Dev Tunnel",
    (s2 IN ("weezo.me", "weezo.net")
        OR s4 == "weezo.en.softonic.com"), "Weezo",
    s2 == "xeox.com", "Xeox",
    s2 == "zabbix.com", "Zabbix Agent",
    s3 IN ("app.zecurit.com", "d1m8kha1zyjal6.cloudfront.net", "dms.zecurit.com"), "Zecurit",
    s2 == "zerotier.com", "ZeroTier",
    (s2 IN ("zoho.com", "zoho.eu", "zoho.in", "zohoassist.com", "zohoassist.jp")
        OR s3 IN (
        "assist.zoho.com", "downloads.zohocdn.com", "gateway.zohoassist.com", "zoho.com.au", "zoho.com.cn",
        "zohoassist.com.cn")
        OR s4 == "downloads.zohodl.com.cn"), "Zoho Assist",
    "")
| EVAL ip_tool = ""
| WHERE COALESCE(tool, "") != "" OR COALESCE(MV_COUNT(addresses), 0) > 0
| MV_EXPAND addresses
| EVAL ip_tool = CASE(COALESCE(addresses, "") == "", "", CASE(
    addresses IN ("136.243.104.235", "136.243.104.242", "136.243.18.122"), "Ammyy Admin",
    addresses IN ("45.153.34.132"), "Komari",
    addresses IN ("77.37.120.252"), "Monitic",
    addresses IN ("192.3.95.152", "198.46.178.135"), "NetBird",
    addresses IN ("172.245.52.169", "45.207.220.12"), "Nezha",
    addresses IN ("160.191.182.41", "192.144.34.42", "51.255.19.178", "51.255.19.179"), "SimpleHelp",
    addresses IN ("18.229.110.98"), "TiFLUX",
    ""))
| WHERE COALESCE(tool, "") != "" OR COALESCE(ip_tool, "") != ""
| EVAL tool = CASE(COALESCE(tool, "") != "", tool, ip_tool)
| EVAL matched = CASE(COALESCE(ip_tool, "") != "" AND (h == "" OR COALESCE(tool, "") == ip_tool), CONCAT("ip ", addresses), CONCAT("domain ", h))
| STATS
    events = MAX(events),
    first_seen = MIN(first_seen),
    last_seen = MAX(last_seen),
    accounts = VALUES(accounts),
    details = VALUES(details),
    addresses = VALUES(addresses)
  BY _index, tool, source, program, matched
| INLINE STATS tool_hosts = COUNT_DISTINCT(_index) BY tool
| EVAL f_not_browser = source != "browser history"
| EVAL f_cmdline = source IN ("URL in command line", "BITS job")
| EVAL score = 2 + CASE(f_not_browser, 1, 0) + CASE(f_cmdline, 2, 0) + CASE(tool_hosts == 1, 1, 0)
| EVAL details = MV_SLICE(details, 0, 9)
| KEEP
    _index,
    score,
    tool,
    matched,
    source,
    program,
    events,
    first_seen,
    last_seen,
    accounts,
    tool_hosts,
    addresses,
    details
| SORT score DESC, first_seen ASC
| LIMIT 10000
