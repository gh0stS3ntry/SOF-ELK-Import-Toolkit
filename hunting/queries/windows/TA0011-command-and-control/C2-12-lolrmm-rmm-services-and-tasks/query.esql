    (key LIKE "*\\\\programdata\\\\total software deployment\\\\*"
        OR key LIKE "*\\\\tniwinagent.exe"
        OR key LIKE "*\\\\total software deployment\\\\*"
        OR key LIKE "*\\\\tsdservice.exe"), "Total Software Deployment",
    (key LIKE "*\\\\program files\\\\trustconnect agent\\\\*"
        OR key LIKE "*\\\\program files\\\\trustconnect agent\\\\trustconnectagent.exe"
        OR key LIKE "*\\\\programdata\\\\trustconnect\\\\*"
        OR key LIKE "*\\\\trustconnectagent.exe"), "TrustConnect",
    (key LIKE "*\\\\program files\\\\uvnc bvba\\\\ultravnc\\\\*"
        OR key LIKE "*\\\\uvnc bvba\\\\ultravnc\\\\*"
        OR key LIKE "*\\\\uvnc_launch.exe"
        OR key LIKE "*\\\\vncviewer.exe"
        OR key LIKE "*\\\\winvnc.exe"), "Ultra VNC",
    (key LIKE "*\\\\program files (x86)\\\\ultraviewer\\\\ultraviewer_desktop.exe"
        OR key LIKE "*\\\\ultraviewer\\\\*"
        OR key LIKE "*\\\\ultraviewer_desktop.exe"), "UltraViewer",
    (key LIKE "*\\\\program files (x86)\\\\veyon\\\\*"
        OR key LIKE "*\\\\program files\\\\veyon\\\\*"
        OR key LIKE "*\\\\program files\\\\veyon\\\\veyon-service.exe"), "Veyon",
    key LIKE "*\\\\program files\\\\vicarius\\\\topia\\\\*", "Vicarius vRx",
    (key LIKE "*\\\\program files (x86)\\\\vector\\\\asset management client\\\\*"
        OR key LIKE "*\\\\program files\\\\vector networks limited\\\\lanutil32 suite\\\\*"
        OR key LIKE "*\\\\program files\\\\vector\\\\asset management client\\\\*"), "VIZOR",
    (key LIKE "*\\\\program files\\\\realvnc\\\\vnc server\\\\*"
        OR key LIKE "*\\\\realvnc\\\\vnc server\\\\*"), "VNC Connect",
    (key LIKE "*\\\\users\\\\ieuser\\\\downloads\\\\winscp-5.21.6-portable\\\\*"
        OR key LIKE "*\\\\winscp*portable\\\\*"
        OR key LIKE "*\\\\winscp.exe"
        OR key LIKE "*\\\\winscp\\\\*"), "WinSCP",
    (key LIKE "*\\\\program files (x86)\\\\xpra\\\\*"
        OR key LIKE "*\\\\xpra-launcher.exe"
        OR key LIKE "*\\\\xpra-x86_64_setup.exe"
        OR key LIKE "*\\\\xpra\\\\*"), "Xpra",
    (key LIKE "*\\\\netsarang\\\\xshell\\\\*"
        OR key LIKE "*\\\\program files (x86)\\\\netsarang\\\\xshell\\\\*"
        OR key LIKE "*\\\\xshell.exe"), "Xshell",
    (key LIKE "*\\\\program files (x86)\\\\yandex\\\\*"
        OR key LIKE "*\\\\yandex\\\\*"
        OR key LIKE "*\\\\yandexdisk2.exe"), "Yandex.Disk",
    (key LIKE "*\\\\program files\\\\zecurit\\\\agent\\\\zecuritagentassetmgr.exe"
        OR key LIKE "*\\\\program files\\\\zecurit\\\\agent\\\\zecuritagentregister.exe"
        OR key LIKE "*\\\\program files\\\\zecurit\\\\agent\\\\zecuritagentservice.exe"
        OR key LIKE "*\\\\program files\\\\zecurit\\\\agent\\\\zecuritagenttray.exe"
        OR key LIKE "*\\\\program files\\\\zecurit\\\\agent\\\\zecuritapplicationcontrolservice.exe"
        OR key LIKE "*\\\\program files\\\\zecurit\\\\agent\\\\zecuritcommandprocessor.exe"
        OR key LIKE "*\\\\program files\\\\zecurit\\\\agent\\\\zecuritlivenotifier.exe"
        OR key LIKE "*\\\\program files\\\\zecurit\\\\agent\\\\zecuritremotetools.exe"
        OR key LIKE "*\\\\program files\\\\zecurit\\\\agent\\\\zecuritscreenreaderapp.exe"
        OR key LIKE "*\\\\program files\\\\zecurit\\\\agent\\\\zecuritscreenreaderappui.exe"
        OR key LIKE "*\\\\program files\\\\zecurit\\\\agent\\\\zecuritscreenreaderservice.exe"
        OR key LIKE "*\\\\windows\\\\temp\\\\zecurit\\\\zecuritagentupgrader.exe"), "Zecurit",
    (key LIKE "*\\\\program files\\\\zoc8\\\\*"
        OR key LIKE "*\\\\zoc?\\\\*"), "ZOC",
    key LIKE "*\\\\za_access.exe", "Zoho Assist",
    ""),
    "")
| WHERE COALESCE(tool, "") != ""
| STATS
    tools = VALUES(tool),
    matched_on = VALUES(role),
    events = MAX(events),
    first_seen = MIN(first_seen),
    last_seen = MAX(last_seen),
    accounts = VALUES(accounts),
    commands = VALUES(commands)
  BY _index, source, svc_name, svc_display, task, image
// one string, so that the host count below groups on the tool set and does not split the row
| EVAL tools = MV_CONCAT(MV_SORT(tools), " + ")
| INLINE STATS tool_hosts = COUNT_DISTINCT(_index) BY tools
| EVAL f_userpath = image RLIKE ".*\\\\(users\\\\public|programdata|perflogs|windows\\\\temp|temp|appdata|downloads|desktop|[$]recycle[.]bin)\\\\.*"
| EVAL f_task = task != ""
| EVAL f_install_event = source IN ("7045 service installed", "4697 service installed", "4698 task created", "Task Scheduler 106")
| EVAL f_name_only = NOT MV_CONTAINS(matched_on, "image") AND NOT MV_CONTAINS(matched_on, "image_path")
| EVAL score = 2 + CASE(f_install_event, 1, 0) + CASE(f_userpath, 2, 0) + CASE(f_task, 1, 0) + CASE(tool_hosts == 1, 1, 0)
    + CASE(f_name_only AND image != "" AND NOT image RLIKE ".*\\\\program files( [(]x86[)])?\\\\.*", 1, 0)
| EVAL reasons = REPLACE(CONCAT(
    CASE(f_install_event, "installed or registered (event); ", ""),
    CASE(f_userpath, "program in a user-writable folder; ", ""),
    CASE(f_task, "scheduled task; ", ""),
    CASE(f_name_only AND image != "" AND NOT image RLIKE ".*\\\\program files( [(]x86[)])?\\\\.*", "RMM name, program outside Program Files; ", ""),
    CASE(tool_hosts == 1, "on one host only; ", "")
  ), "; $", "")
| KEEP
    _index,
    score,
    reasons,
    tools,
    matched_on,
    source,
    svc_name,
    svc_display,
    task,
    image,
    commands,
    accounts,
    events,
    first_seen,
    last_seen,
    tool_hosts
| SORT score DESC, first_seen ASC
| LIMIT 10000
