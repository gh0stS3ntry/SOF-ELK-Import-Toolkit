// TRI-02 | Event log sources per host
// Tactic: Triage (first cut) | ATT&CK: n/a
// Indexes: evtxlogs-* | Needs: nothing
FROM evtxlogs-* METADATA _index
| EVAL eid = TO_STRING(winlog.event_id)
| EVAL ch = TO_STRING(winlog.channel)
| EVAL prov = TO_LOWER(COALESCE(TO_STRING(winlog.provider_name), ""))
| EVAL source = CASE(
    ch == "Security" AND eid == "4688", "Process creation: Security 4688",
    ch == "Microsoft-Windows-Sysmon/Operational" AND eid == "1", "Process creation: Sysmon 1",
    ch == "Microsoft-Windows-Sysmon/Operational" AND eid == "3", "Network: Sysmon 3",
    ch == "Microsoft-Windows-Sysmon/Operational", "Sysmon (other event IDs)",
    ch == "Microsoft-Windows-PowerShell/Operational" AND eid == "4104", "PowerShell script block 4104",
    ch == "Microsoft-Windows-PowerShell/Operational" AND eid == "4103", "PowerShell module logging 4103",
    ch == "Windows PowerShell", "Windows PowerShell 400/600/800",
    ch == "Security" AND eid IN ("4624", "4625", "4634", "4647", "4648", "4672"), "Logons: Security 4624/4625/4634/4647/4648/4672",
    ch == "Security" AND eid IN ("4768", "4769", "4771", "4776"), "Authentication on DC: 4768/4769/4771/4776",
    ch == "Security" AND eid IN ("4662", "5136", "5137", "5141"), "Directory service access/changes: 4662/5136/5137/5141",
    ch == "Security" AND eid IN ("4720", "4722", "4724", "4725", "4726", "4728", "4732", "4738", "4756"), "Account and group management",
    ch == "Security" AND eid IN ("5156", "5157"), "Network: WFP 5156/5157",
    ch == "Security" AND eid IN ("5140", "5145"), "File share access 5140/5145",
    ch == "Security" AND eid IN ("4698", "4699", "4700", "4701", "4702"), "Scheduled task audit 4698-4702",
    ch == "Security" AND eid == "4697", "Service install audit 4697",
    ch == "Security" AND eid IN ("1102", "1100", "4719"), "Log cleared / audit policy 1102/1100/4719",
    ch == "System" AND eid == "7045", "Service install: System 7045",
    ch == "System" AND eid IN ("104", "7036", "7040"), "System 104/7036/7040",
    ch LIKE "*TaskScheduler*", "Task Scheduler operational",
    ch LIKE "*Windows Defender*", "Microsoft Defender",
    ch LIKE "*TerminalServices*" OR ch LIKE "*RdpCoreTS*", "RDP (TerminalServices / RdpCoreTS)",
    ch LIKE "*WMI-Activity*", "WMI activity",
    ch LIKE "*WinRM*", "WinRM",
    ch LIKE "*Bits-Client*", "BITS client",
    ch LIKE "*Firewall*" OR (ch == "Security" AND eid IN ("4946", "4947", "4948", "4950")), "Windows Firewall rule changes",
    ch == "Application" AND prov LIKE "mssql*", "SQL Server (Application log)",
    ch == "Application" AND prov LIKE "asp.net*", "ASP.NET (Application log)",
    ch LIKE "Microsoft-Windows-IIS*", "IIS operational logs",
    CONCAT("Other: ", ch)
  )
| STATS
    events = COUNT(*),
    no_event_time = COUNT(*) WHERE winlog.time_created IS NULL,
    first_event = MIN(@timestamp),
    last_event = MAX(@timestamp),
    event_ids = VALUES(eid)
  BY _index, source
| KEEP
    _index,
    source,
    events,
    no_event_time,
    first_event,
    last_event,
    event_ids
| SORT _index ASC, source ASC
| LIMIT 10000
