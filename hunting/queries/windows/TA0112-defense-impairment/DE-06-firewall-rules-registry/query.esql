// DE-06 | Inbound allow rules and odd programs in the firewall rule list (registry)
// Tactic: TA0112 Defense Impairment | ATT&CK: T1562.004, T1219
// Indexes: registry-* | Needs: RECmd FirewallRules plugin (event.dataset: registry.firewallrules)
FROM registry-* METADATA _index
| WHERE event.dataset == "registry.firewallrules"
| EVAL action = TO_LOWER(COALESCE(registry.plugin.action, ""))
| EVAL active = TO_LOWER(COALESCE(registry.plugin.active, ""))
| EVAL dir = TO_LOWER(COALESCE(registry.plugin.dir, ""))
| EVAL app = TO_LOWER(COALESCE(registry.plugin.app, ""))
| EVAL rname = COALESCE(registry.plugin.name, registry.value, "")
| EVAL lport = COALESCE(registry.plugin.l_port, "")
| WHERE active == "true" AND action == "allow"
| EVAL f_inbound = dir == "in"
| EVAL f_userpath = app RLIKE ".*\\\\(users\\\\public|programdata|perflogs|windows\\\\temp|temp|appdata|downloads|[$]recycle[.]bin)\\\\.*"
| EVAL f_lolbin = app RLIKE ".*\\\\(powershell|pwsh|rundll32|regsvr32|mshta|wscript|cscript|cmd|certutil|msbuild|notepad|svchost)[.]exe" AND NOT app LIKE "*svchost.exe"
| EVAL f_rat = app RLIKE ".*(anydesk|teamviewer|screenconnect|rustdesk|ngrok|cloudflared|chisel|frpc|plink|netsupport|client32|atera|splashtop|meshagent|simplehelp|radmin|tightvnc|ultravnc|winvnc|tvnserver).*"
    OR TO_LOWER(rname) RLIKE ".*(anydesk|teamviewer|screenconnect|rustdesk|ngrok|vnc|remote).*"
| EVAL f_admin_port = lport IN ("3389", "445", "135", "5985", "5986", "22", "23", "5900", "1433", "4444", "8080", "*")
| EVAL f_no_app = app == "" AND f_inbound
| EVAL score = CASE(f_userpath, 3, 0) + CASE(f_lolbin, 3, 0) + CASE(f_rat, 3, 0) + CASE(f_inbound AND f_admin_port, 2, 0) + CASE(f_no_app AND lport == "*", 2, 0)
| INLINE STATS rule_hosts = COUNT_DISTINCT(_index) BY rname, app
| EVAL score = score + CASE(rule_hosts == 1, 1, 0)
| WHERE score >= 2
| KEEP
    _index,
    score,
    rname,
    dir,
    action,
    app,
    lport,
    registry.plugin.r_port,
    registry.plugin.protocol,
    registry.plugin.desc,
    rule_hosts,
    f_userpath,
    f_lolbin,
    f_rat,
    f_admin_port,
    registry.last_write,
    registry.key
| SORT score DESC, rule_hosts ASC
| LIMIT 5000
