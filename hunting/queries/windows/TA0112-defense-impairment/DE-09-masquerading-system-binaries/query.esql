// DE-09 | Masquerading: Windows binary names in the wrong folder, and look-alike names
// Tactic: TA0112 Defense Impairment | ATT&CK: T1036.005, T1036.003, T1036.004
// Indexes: amcache-*, shimcache-*, prefetch-* | Needs: any of the three
FROM amcache-*, shimcache-*, prefetch-* METADATA _index
| EVAL exe_path = TO_LOWER(COALESCE(file.path, file.target.path, ""))
| WHERE exe_path LIKE "*.exe" AND exe_path LIKE "*\\\\*"
| EVAL exe_name = REPLACE(exe_path, "^.*\\\\", "")
| EVAL exe_dir = REPLACE(REPLACE(exe_path, "\\\\[^\\\\]*$", ""), "^(\\\\device\\\\harddiskvolume[0-9]+|[a-z]:|\\\\volume[{][^}]*[}])", "")
| EVAL f_sysname = exe_name IN ("svchost.exe", "lsass.exe", "csrss.exe", "smss.exe", "services.exe", "winlogon.exe", "wininit.exe", "spoolsv.exe", "taskhostw.exe", "taskhost.exe", "rundll32.exe", "dllhost.exe", "conhost.exe", "lsm.exe", "lsaiso.exe", "sihost.exe", "ctfmon.exe", "fontdrvhost.exe", "dwm.exe", "searchindexer.exe", "wuauclt.exe", "wermgr.exe", "werfault.exe", "msiexec.exe", "regsvr32.exe", "mshta.exe", "cmd.exe", "powershell.exe", "wmiprvse.exe", "audiodg.exe", "userinit.exe", "taskmgr.exe", "notepad.exe", "certutil.exe", "schtasks.exe", "sc.exe", "net.exe", "net1.exe", "explorer.exe")
| EVAL f_expected_dir = exe_dir RLIKE "\\\\windows(\\\\system32|\\\\syswow64|\\\\winsxs\\\\.*|\\\\servicing\\\\.*|\\\\softwaredistribution\\\\.*|\\\\systemapps\\\\.*|\\\\system32\\\\windowspowershell\\\\v1[.]0|\\\\syswow64\\\\windowspowershell\\\\v1[.]0|\\\\system32\\\\wbem|\\\\syswow64\\\\wbem|\\\\temp\\\\[^\\\\]+[.]tmp|\\\\uus\\\\.*)?"
    OR (exe_name == "explorer.exe" AND exe_dir RLIKE "\\\\windows")
    OR exe_dir RLIKE ".*\\\\([$]windows[.][~]bt|windows[.]old)(\\\\.*)?"
| EVAL f_wrong_dir = f_sysname AND NOT f_expected_dir
| EVAL f_lookalike = exe_name RLIKE "(scvhost|svchosts|svch0st|svhost|svchost32|svchosst|svchos|lsas|lssass|lsasss|isass|1sass|lsaas|csrs|cssrs|crss|smms|servics|service|winlogin|winlogon32|winiinit|spoolsvc|spools|taskhostt|taskhosts|rundl32|rundll|rundll64|dlhost|dllhst|conhst|expl0rer|explorar|explore|iexplorer|powershel|powershel1|cmd32|regsvr|msiexe|wmiprvse32|wmipsrv)[.]exe"
| WHERE f_wrong_dir OR f_lookalike
| EVAL artifact = REPLACE(_index, "-.*$", "")
| STATS
    host_count = COUNT_DISTINCT(_index),
    artifacts = VALUES(artifact),
    sha1_values = VALUES(file.hash.sha1),
    products = VALUES(file.pe.product),
    first_seen = MIN(COALESCE(amcache.file_key_last_write, file.mtime, @timestamp)),
    last_seen = MAX(COALESCE(amcache.file_key_last_write, file.mtime, @timestamp)),
    source_indices = VALUES(_index)
  BY exe_name, exe_dir, f_wrong_dir, f_lookalike
| EVAL score = CASE(f_lookalike, 4, 0) + CASE(f_wrong_dir, 3, 0)
    + CASE(exe_dir RLIKE ".*\\\\(users\\\\public|programdata|perflogs|windows\\\\temp|temp|appdata|downloads|[$]recycle[.]bin)(\\\\.*)?", 2, 0)
    + CASE(host_count == 1, 1, 0)
| KEEP source_indices, host_count, score, exe_name, exe_dir, f_wrong_dir, f_lookalike, artifacts, products, first_seen, last_seen, sha1_values
| SORT score DESC, first_seen ASC
| LIMIT 2000
