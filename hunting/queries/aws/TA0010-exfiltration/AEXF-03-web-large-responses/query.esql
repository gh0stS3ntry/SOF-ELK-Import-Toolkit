// AEXF-03 | Clients that pulled the most data from the web front end (ALB/ELB and other web servers)
// Tactic: TA0010 Exfiltration | ATT&CK: T1530, T1567
// Indexes: httpdlog-* | Needs: web access logs with response sizes (destination.bytes): ALB or Classic ELB, or IIS/NGINX/Apache
FROM httpdlog-* METADATA _index
| EVAL big = COALESCE(destination.bytes, 0) >= 10485760  // EDIT: 10 MB
| STATS
    requests = COUNT(*),
    bytes_sent = SUM(destination.bytes),
    large_responses = COUNT(*) WHERE big,
    distinct_paths = COUNT_DISTINCT(url.path),
    large_paths = VALUES(url.path) WHERE big,
    statuses = VALUES(http.response.status_code),
    user_agents = VALUES(user_agent.original),
    first_seen = MIN(@timestamp),
    last_seen = MAX(@timestamp)
  BY _index, source.ip
| EVAL mb_sent = ROUND(COALESCE(bytes_sent, 0) / 1048576.0, 1)
| INLINE STATS median_mb = MEDIAN(mb_sent) BY _index
| EVAL large_paths = MV_SLICE(large_paths, 0, 19), user_agents = MV_SLICE(user_agents, 0, 4)
| KEEP
    _index,
    source.ip,
    mb_sent,
    median_mb,
    requests,
    large_responses,
    distinct_paths,
    statuses,
    first_seen,
    last_seen,
    large_paths,
    user_agents
| SORT mb_sent DESC
| LIMIT 500
