// LC2-05 | LOLRMM: RMM and remote-access tools on Linux: programs run, files on disk, systemd units
// Tactic: TA0011 Command and Control | ATT&CK: T1219, T1543.002
// Indexes: logstash-*, auditd-*, bodyfile-*, linuxconfig-* | Needs: any of logstash-*, auditd-*, bodyfile-*, linuxconfig-*
// GENERATED by hunting/tools/lolrmm.py from the LOLRMM catalog (2026-11-20, 354 tools, sha256 607f5195c0a1); edit the template there, not this file
FROM logstash-*, auditd-*, bodyfile-*, linuxconfig-* METADATA _index
| WHERE host.os.type == "linux"
| EVAL source = CASE(
    event.dataset == "bodyfile", "bodyfile",
    event.dataset == "linux.systemd_unit", "systemd unit",
    STARTS_WITH(event.dataset, "linux."), "",
    process.executable IS NOT NULL OR process.command_line IS NOT NULL, CONCAT("process (", event.dataset, ")"),
    "")
| WHERE source != ""
| EVAL program = CASE(
    source == "bodyfile", COALESCE(file.path, ""),
    source == "systemd unit", REPLACE(COALESCE(MV_FIRST(linuxconfig.systemd.exec_start), ""), "^([^ ]+).*$", "$1"),
    COALESCE(process.executable, REPLACE(COALESCE(process.command_line, ""), "^([^ ]+).*$", "$1")))
| EVAL unit = CASE(source == "systemd unit", TO_LOWER(COALESCE(linuxconfig.systemd.unit, "")), "")
| EVAL detail = CASE(source == "bodyfile", "", source == "systemd unit", COALESCE(file.path, ""), COALESCE(process.command_line, ""))
// first pass, one regex: a folder or program name that an LOLRMM Linux path requires (or a unit)
| WHERE unit != "" OR (program != "" AND REPLACE(program, "^.*?(?:^|\\/)(?:(?:\\.tmate\\.conf|0x101_Cyber_Security|AnyDesk|Borealis|ControlR(?:\\.Agent)?|Remotely(?:_(?:Agent|Desktop))?|T(?:eleport Connect|opiaTrace\\.log)|a(?:gentservice|utostart)|b(?:eacon(?:\\-agent(?:\\.(?:log|service))?)?|orealis\\-agent(?:\\-(?:updater\\.service|watchdog\\.service)|\\.service)|reeze(?:\\-(?:agent(?:\\-user\\.service|\\.(?:conf|service))?|backup|desktop\\-helper|watchdog))?)|c(?:hrome\\-remote\\-desktop(?:\\-host|\\.service)?|o(?:mmandProcessor|n(?:fig\\.yaml|trolr)))|d(?:a(?:shboard|taplicity(?:\\.service)?)|iscovery_agent)|glpi\\-agent(?:\\.service)?|helpwire\\-unattended\\.service|komari(?:\\-agent\\.service|\\.service)?|loclx|m(?:esh(?:_services|agent)|inion\\.service|sp\\-agent)|ne(?:t(?:bird|lock\\-rmm\\-agent\\-comm\\.(?:log|service))|zha(?:\\-(?:agent(?:\\.service)?|dashboard\\.service))?)|o(?:bliance\\-(?:agent(?:\\.(?:log|service))?|watchdog\\.service)|penuem\\-agent)|p(?:itunnel(?:\\.service)?|roxiport(?:\\-agent|\\.service)?)|r(?:emotely(?:\\-agent\\.service)?|gsupv|mm(?:\\-agent\\.service|max\\-agent(?:\\.service)?)?|oster(?:\\-agent(?:\\.(?:log|service))?)?)|s(?:entinel\\-agent(?:\\.service)?|hellhub\\-agent(?:\\.service)?)|t(?:e(?:leport(?:\\-connect\\.desktop)?|ramind)|m(?:ate|sysd)|opiaInstaller\\.log|sh)|vicarius|zecurit_agent(?:\\.service)?)|controlr\\.agent[^\\/]*\\.service|tmate[^\\/]*)(?:\\/.*)?$", "") == "")
| STATS
    records = COUNT(*),
    first_seen = MIN(@timestamp),
    last_seen = MAX(@timestamp),
    accounts = VALUES(user.name),
    details = VALUES(detail)
  BY _index, source, program, unit
| EVAL keys = MV_DEDUPE(MV_APPEND(MV_APPEND(CONCAT("path|", program), CONCAT("name|", REPLACE(program, "^.*/", ""))), CONCAT("unit|", unit)))
| MV_EXPAND keys
| EVAL role = REPLACE(keys, "[|].*$", "")
| EVAL key = REPLACE(keys, "^[^|]*[|]", "")
| WHERE key != ""
| EVAL tool = CASE(
    role == "path", CASE(
    key LIKE "/*/.config/AnyDesk/Logs", "AnyDesk",
    (key LIKE "/etc/beacon/agent.log"
        OR key LIKE "/etc/beacon/credential.json"
        OR key LIKE "/etc/systemd/system/beacon-agent.service"
        OR key LIKE "/usr/local/bin/beacon-agent"
        OR key LIKE "/var/log/beacon-agent.log"), "Beacon (Synertek)",
    (key LIKE "/etc/systemd/system/borealis-agent-updater.service"
        OR key LIKE "/etc/systemd/system/borealis-agent-watchdog.service"
        OR key LIKE "/etc/systemd/system/borealis-agent.service"
        OR key LIKE "/opt/Borealis/Agent/Agent"
        OR key LIKE "/opt/Borealis/Agent/Logs/Agent/agent.log"
        OR key LIKE "/opt/Borealis/Agent/agent.json"), "Borealis",
    (key LIKE "/etc/breeze/*"
        OR key LIKE "/etc/breeze/agent.yaml"
        OR key LIKE "/etc/systemd/system/breeze-agent.service"
        OR key LIKE "/etc/xdg/autostart/breeze-agent-user.desktop"
        OR key LIKE "/usr/lib/systemd/user/breeze-agent-user.service"
        OR key LIKE "/usr/lib/tmpfiles.d/breeze-agent.conf"
        OR key LIKE "/usr/local/bin/breeze-agent"
        OR key LIKE "/usr/local/bin/breeze-backup"
        OR key LIKE "/usr/local/bin/breeze-desktop-helper"
        OR key LIKE "/usr/local/bin/breeze-watchdog"
        OR key LIKE "/var/lib/breeze/*"
        OR key LIKE "/var/log/breeze/*"
        OR key LIKE "/var/run/breeze/agent.sock"), "BreezeRMM",
    (key LIKE "/lib/systemd/system/chrome-remote-desktop.service"
        OR key LIKE "/opt/google/chrome-remote-desktop/chrome-remote-desktop"
        OR key LIKE "/opt/google/chrome-remote-desktop/chrome-remote-desktop-host"), "Chrome Remote Desktop",
    (key LIKE "/*/.controlr/*/logs/ControlR.Agent/LogFile*.log"
        OR key LIKE "/etc/controlr/*/appsettings.json"
        OR key LIKE "/etc/systemd/system/controlr.agent*.service"
        OR key LIKE "/usr/local/bin/ControlR/*"
        OR key LIKE "/usr/local/bin/ControlR/*/ControlR.Agent"
        OR key LIKE "/var/log/controlr/*/ControlR.Agent/LogFile*.log"), "ControlR",
    (key LIKE "/etc/init.d/dataplicity/*"
        OR key LIKE "/etc/systemd/system/dataplicity.service"
        OR key LIKE "/opt/dataplicity/*"
        OR key LIKE "/opt/dataplicity/credentials/*"
        OR key LIKE "/opt/dataplicity/tuxtunnel/*"
        OR key LIKE "/opt/dataplicity/tuxtunnel/manager"
        OR key LIKE "/usr/local/bin/dataplicity"), "Dataplicity",
    key LIKE "/opt/freshservice/discovery_agent/*", "Freshservice",
    (key LIKE "/etc/glpi-agent/*"
        OR key LIKE "/etc/glpi-agent/agent.cfg"
        OR key LIKE "/etc/glpi-agent/conf.d/*"
        OR key LIKE "/lib/systemd/system/glpi-agent.service"
        OR key LIKE "/usr/bin/glpi-agent"
        OR key LIKE "/usr/local/bin/glpi-agent"
        OR key LIKE "/var/lib/glpi-agent/*"), "GLPI Agent",
    (key LIKE "/etc/systemd/system/rmm-agent.service"
        OR key LIKE "/opt/rmm/agent/*"), "Go Mini RMM",
    key LIKE "/lib/systemd/system/helpwire-unattended.service", "HelpWire",
    (key LIKE "/etc/systemd/system/komari-agent.service"
        OR key LIKE "/etc/systemd/system/komari.service"
        OR key LIKE "/opt/komari/*"
        OR key LIKE "/opt/komari/agent/*"
        OR key LIKE "/opt/komari/komari/*"
        OR key LIKE "/usr/local/komari/*"), "Komari",
    (key LIKE "/*/.loclx/config.yaml"
        OR key LIKE "/usr/local/bin/loclx"), "LocalXpose",
    (key LIKE "/usr/local/mesh_services/meshagent/*"
        OR key LIKE "/usr/local/mesh_services/meshagent/meshagent"
        OR key LIKE "/usr/local/mesh_services/meshagent/meshagent.db"
        OR key LIKE "/usr/local/mesh_services/meshagent/meshagent.msh"
        OR key LIKE "/usr/local/mesh_services/meshagent/meshagent/*"), "MeshCentral",
    key LIKE "/etc/systemd/system/minion.service", "Minexus",
    key LIKE "/opt/msp-agent/*", "N-able N-central",
    (key LIKE "/etc/netbird/config.json"
        OR key LIKE "/etc/netbird/install.conf"
        OR key LIKE "/opt/netbird/*"
        OR key LIKE "/usr/bin/netbird"
        OR key LIKE "/usr/local/bin/netbird"
        OR key LIKE "/var/log/netbird/*"), "NetBird",
    (key LIKE "/etc/systemd/system/netlock-rmm-agent-comm.service"
        OR key LIKE "/usr/0x101_Cyber_Security/Netlock_RMM/*"
        OR key LIKE "/usr/local/bin/0x101_Cyber_Security/Netlock_RMM/*"
        OR key LIKE "/var/0x101_Cyber_Security/*"
        OR key LIKE "/var/log/netlock-rmm-agent-comm.log"), "NetLock RMM",
    (key LIKE "/etc/systemd/system/nezha-agent.service"
        OR key LIKE "/etc/systemd/system/nezha-dashboard.service"
        OR key LIKE "/opt/nezha/*"
        OR key LIKE "/opt/nezha/agent/*"
        OR key LIKE "/opt/nezha/agent/config.yml"
        OR key LIKE "/opt/nezha/agent/nezha-agent"
        OR key LIKE "/opt/nezha/dashboard/*"
        OR key LIKE "/opt/nezha/dashboard/app"), "Nezha",
    (key LIKE "/etc/obliance-agent/config.json"
        OR key LIKE "/etc/systemd/system/obliance-agent.service"
        OR key LIKE "/etc/systemd/system/obliance-watchdog.service"
        OR key LIKE "/opt/obliance-agent/obliance-agent/*"
        OR key LIKE "/usr/local/bin/obliance-agent"
        OR key LIKE "/var/log/obliance-agent.log"), "Obliance",
    (key LIKE "/etc/openuem-agent/openuem.ini"
        OR key LIKE "/var/log/openuem-agent/openuem-agent.log"), "OpenUEM",
    (key LIKE "/etc/systemd/system/pitunnel.service"
        OR key LIKE "/opt/pitunnel/*"
        OR key LIKE "/usr/local/bin/pitunnel"), "PiTunnel",
    (key LIKE "/etc/proxiport/proxiport.conf"
        OR key LIKE "/lib/systemd/system/proxiport.service"
        OR key LIKE "/usr/bin/proxiport"
        OR key LIKE "/var/lib/proxiport-agent/*"
        OR key LIKE "/var/log/proxiport-agent/*"), "ProxiPort",
    (key LIKE "/etc/systemd/system/remotely-agent.service"
        OR key LIKE "/usr/local/bin/Remotely/ConnectionInfo.json"
        OR key LIKE "/usr/local/bin/Remotely/Desktop/Remotely_Desktop"
        OR key LIKE "/usr/local/bin/Remotely/Remotely_Agent"
        OR key LIKE "/var/log/remotely/Agent_Install.log"), "Remotely",
    key LIKE "/etc/init.d/rgsupv/*", "RG System (RG Supervision)",
    (key LIKE "/etc/systemd/system/rmmmax-agent.service"
        OR key LIKE "/usr/local/bin/rmmmax-agent"
        OR key LIKE "/var/rmmmax/agentservice/activity.log"
        OR key LIKE "/var/rmmmax/agentservice/config.json"
        OR key LIKE "/var/rmmmax/agentservice/rmmmax_agent.py"), "RMMmax",
    (key LIKE "/etc/roster/agent.yaml"
        OR key LIKE "/etc/systemd/system/roster-agent.service"
        OR key LIKE "/usr/local/bin/roster-agent"
        OR key LIKE "/var/log/roster-agent.log"), "Roster",
    (key LIKE "/etc/systemd/system/sentinel-agent.service"
        OR key LIKE "/opt/sentinel-agent/sentinel-agent/*"
        OR key LIKE "/usr/local/sentinel-agent/sentinel-agent"), "Sentinel RMM",
    (key LIKE "/etc/shellhub-agent/*"
        OR key LIKE "/etc/shellhub-agent/agent.env"
        OR key LIKE "/etc/systemd/system/shellhub-agent.service"
        OR key LIKE "/usr/local/bin/shellhub-agent"
        OR key LIKE "/var/lib/shellhub-agent/*"), "ShellHub",
    (key LIKE "/home/*/.cache/Teleport Connect/teleport/teleport"
        OR key LIKE "/home/*/.config/Teleport Connect/app_config.json"
        OR key LIKE "/home/*/.config/Teleport Connect/app_state.json"
        OR key LIKE "/home/*/.config/Teleport Connect/certs/tshd.crt"
        OR key LIKE "/home/*/.config/Teleport Connect/logs/*"
        OR key LIKE "/opt/Teleport Connect/*"
        OR key LIKE "/opt/Teleport Connect/resources/bin/tsh"
        OR key LIKE "/opt/Teleport Connect/teleport-connect/*"
        OR key LIKE "/usr/local/bin/tsh"
        OR key LIKE "/usr/share/applications/teleport-connect.desktop"), "Teleport Connect",
    (key LIKE "/usr/local/teramind/agent/bin"
        OR key LIKE "/usr/local/teramind/agent/bin/tmsysd"
        OR key LIKE "/usr/local/teramind/agent/etc"), "Teramind",
    (key LIKE "/*/.tmate.conf"
        OR key LIKE "/tmp/tmate*"
        OR key LIKE "/usr/bin/tmate"
        OR key LIKE "/usr/local/bin/tmate"), "tmate",
    (key LIKE "/usr/share/vicarius/*"
        OR key LIKE "/usr/share/vicarius/topiad.config"
        OR key LIKE "/var/log/TopiaTrace.log"
        OR key LIKE "/var/log/topiaInstaller.log"), "Vicarius vRx",
    (key LIKE "/etc/systemd/system/zecurit_agent.service"
        OR key LIKE "/usr/local/zecurit_agent/RemoveAgent.sh"
        OR key LIKE "/usr/local/zecurit_agent/bin/agentService"
        OR key LIKE "/usr/local/zecurit_agent/bin/commandProcessor"
        OR key LIKE "/usr/local/zecurit_agent/bin/installer"
        OR key LIKE "/usr/local/zecurit_agent/config/server.json"), "Zecurit",
    ""),
    role == "name", CASE(
    key IN ("beacon-agent"), "Beacon (Synertek)",
    key IN ("breeze-agent", "breeze-backup", "breeze-desktop-helper", "breeze-watchdog"), "BreezeRMM",
    key IN ("chrome-remote-desktop", "chrome-remote-desktop-host"), "Chrome Remote Desktop",
    key IN ("dataplicity"), "Dataplicity",
    key IN ("glpi-agent"), "GLPI Agent",
    key IN ("loclx"), "LocalXpose",
    key IN ("meshagent"), "MeshCentral",
    key IN ("netbird"), "NetBird",
    key IN ("nezha-agent"), "Nezha",
    key IN ("obliance-agent"), "Obliance",
    key IN ("pitunnel"), "PiTunnel",
    key IN ("proxiport"), "ProxiPort",
    key IN ("Remotely_Agent", "Remotely_Desktop"), "Remotely",
    key IN ("rmmmax-agent"), "RMMmax",
    key IN ("roster-agent"), "Roster",
    key IN ("sentinel-agent"), "Sentinel RMM",
    key IN ("shellhub-agent"), "ShellHub",
    key IN ("teleport"), "Teleport Connect",
    key IN ("tmsysd"), "Teramind",
    key IN ("tmate"), "tmate",
    ""),
    role == "unit", CASE(
    key IN ("beacon-agent.service"), "Beacon (Synertek)",
    key IN ("borealis-agent-updater.service", "borealis-agent-watchdog.service", "borealis-agent.service"), "Borealis",
    key IN ("rmm-agent.service"), "Go Mini RMM",
    key IN ("minion.service"), "Minexus",
    key IN ("mspagent.service"), "N-able N-central",
    key IN ("obliance-agent.service", "obliance-watchdog.service"), "Obliance",
    key IN ("proxiport.service"), "ProxiPort",
    key IN ("remotely-agent.service"), "Remotely",
    key IN ("rgsupv.service"), "RG System (RG Supervision)",
    key IN ("roster-agent.service"), "Roster",
    key IN ("sentinel-agent.service"), "Sentinel RMM",
    key IN ("zecurit_agent.service"), "Zecurit",
    ""),
    "")
| WHERE COALESCE(tool, "") != ""
| STATS
    matched_on = VALUES(role),
    records = MAX(records),
    first_seen = MIN(first_seen),
    last_seen = MAX(last_seen),
    accounts = VALUES(accounts),
    details = VALUES(details)
  BY _index, tool, source, program, unit
| INLINE STATS tool_hosts = COUNT_DISTINCT(_index) BY tool
| EVAL f_ran = STARTS_WITH(source, "process")
| EVAL f_tmp = program RLIKE "/(tmp|var/tmp|dev/shm|home/[^/]+|root)/.*"
| EVAL score = 2 + CASE(f_ran, 2, 0) + CASE(source == "systemd unit", 1, 0) + CASE(f_tmp, 2, 0) + CASE(tool_hosts == 1, 1, 0)
| EVAL details = MV_SLICE(details, 0, 9)
| KEEP
    _index,
    score,
    tool,
    matched_on,
    source,
    program,
    unit,
    records,
    first_seen,
    last_seen,
    accounts,
    tool_hosts,
    details
| SORT score DESC, first_seen ASC
| LIMIT 10000
